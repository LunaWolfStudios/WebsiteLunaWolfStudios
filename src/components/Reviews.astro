---
/**
 * A set of ReviewCards. No JavaScript: a responsive grid, or a horizontal scroll-snap row
 * that shows a peek of the next card (swipe on touch, shift+wheel or the scrollbar on desktop).
 *
 *   <Reviews reviews={REVIEWS.filter((r) => r.about === "Hypno Halo")} showAbout={false} />
 *   <Reviews reviews={REVIEWS} layout="row" label="What players and press say" />
 */
import ReviewCard from "./ReviewCard.astro";
import type { Review } from "../data/types";

interface Props {
  reviews: Review[];
  layout?: "grid" | "row";
  showAbout?: boolean;
  /** Accessible name for the list. */
  label?: string;
  class?: string;
}

const { reviews, layout = "grid", showAbout = true, label = "Reviews", class: cls } = Astro.props;
---

<ul
  class:list={["reviews", `reviews--${layout}`, cls]}
  role="list"
  aria-label={label}
  tabindex={layout === "row" ? 0 : undefined}
>
  {
    reviews.map((review, i) => (
      <li data-reveal style={`--reveal-delay:${Math.min(i, 5) * 70}ms`}>
        <ReviewCard review={review} showAbout={showAbout} />
      </li>
    ))
  }
</ul>

<style>
  .reviews {
    margin: 0;
    padding: 0;
  }
  .reviews--grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(1rem, 2.2vw, 1.5rem);
  }
  .reviews--row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(380px, 84%);
    gap: clamp(1rem, 2.2vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
    padding: 4px 2px 1.1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--lw-border-strong) transparent;
  }
  .reviews--row > li {
    scroll-snap-align: start;
  }
  .reviews--row:focus-visible {
    outline: 2px solid var(--lw-accent);
    outline-offset: 4px;
    border-radius: var(--lw-radius);
  }
</style>
