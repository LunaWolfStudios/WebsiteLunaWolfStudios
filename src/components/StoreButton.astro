---
/**
 * Outbound store link: "Wishlist on / Steam", "Get it on the / Unity Asset Store".
 *
 *   <StoreButton kind="steam" href={LINKS.sheepTag2Steam} verb="Wishlist on" placement="game_page" />
 *   <StoreButton kind="unity" href={LINKS.scriptableSheets} variant="primary" />
 *   <StoreButton link={game.links[0]} placement="games" size="sm" />
 *
 * The button is the site's own pill with the platform's mark on the left and the store named
 * in two lines of text. These are the studio's own products and the owner wants the platform
 * visible on the button, so every store kind carries its mark (see src/lib/icons.ts). The
 * full official logos go beside the buttons with <AvailableOn>. itch.io and Apple also
 * publish finished badges that may be the link itself; pass `artwork` to use one instead of
 * the pill.
 *
 * - kind: steam | switch | unity | itch | newgrounds | web | apple | android | meta | kickstarter | youtube
 * - verb: small line ("Available on" by default). label: big line (the store name).
 * - variant: "secondary" (default, outlined) or "primary" (filled; one per group).
 * - placement: tags the URL with UTM via withUtm() so store analytics see the click.
 * - artwork: use the official badge image for this kind (itch, apple) instead of the pill.
 *   Swap artwork by editing BADGES below (paths relative to src/assets/brands/).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { withUtm, type LinkPlacement } from "../data/links";
import type { StoreKind, StoreLink } from "../data/types";

const KINDS: Record<StoreKind, { verb: string; label: string }> = {
  steam: { verb: "Available on", label: "Steam" },
  switch: { verb: "Buy on", label: "Nintendo eShop" },
  unity: { verb: "Get it on the", label: "Unity Asset Store" },
  itch: { verb: "Play on", label: "itch.io" },
  newgrounds: { verb: "Play on", label: "Newgrounds" },
  web: { verb: "Visit the", label: "Official site" },
  apple: { verb: "Download on the", label: "App Store" },
  android: { verb: "Get it on", label: "Google Play" },
  meta: { verb: "Available on", label: "Meta Quest" },
  kickstarter: { verb: "See it on", label: "Kickstarter" },
  youtube: { verb: "Watch on", label: "YouTube" },
};

/** The platform mark shown on the pill, by kind. "web" has none and keeps the outbound arrow. */
const MARKS: Partial<Record<StoreKind, string>> = {
  steam: "steam",
  switch: "switch",
  unity: "unity",
  itch: "itch",
  newgrounds: "newgrounds",
  apple: "appstore",
  android: "googleplay",
  meta: "meta",
  kickstarter: "kickstarter",
  youtube: "youtube",
};

/** Official badges that may be the link itself. Paths are relative to src/assets/brands/. */
const BADGES: Partial<Record<StoreKind, string>> = {
  itch: "itch/itch-badge-dark.svg",
  apple: "apple/download-on-the-app-store-black.svg",
};

const brandFiles = import.meta.glob<ImageMetadata>("../assets/brands/**/*.{svg,png,webp}", {
  eager: true,
  import: "default",
});
const brandFile = (rel?: string) => (rel ? brandFiles[`../assets/brands/${rel}`] : undefined);

interface Props {
  kind?: StoreKind;
  href?: string;
  /** Alternative to kind + href: a StoreLink from the data files. */
  link?: StoreLink;
  verb?: string;
  label?: string;
  variant?: "primary" | "secondary";
  placement?: LinkPlacement;
  size?: "sm" | "md";
  artwork?: boolean;
  class?: string;
}

const props = Astro.props;
const kind: StoreKind = props.link?.kind ?? props.kind ?? "web";
const rawHref = props.link?.url ?? props.href ?? "#";
const meta = KINDS[kind];
const verb = props.verb ?? meta.verb;
const label = props.label ?? props.link?.label ?? meta.label;
const href = props.placement && /^https?:/.test(rawHref) ? withUtm(rawHref, props.placement) : rawHref;
const size = props.size ?? "md";
const variant = props.variant ?? "secondary";
const badge = props.artwork === true ? brandFile(BADGES[kind]) : undefined;
const badgeH = size === "sm" ? 40 : 48;
const mark = MARKS[kind];
---

{
  badge ? (
    <a class:list={["store-badge-link", props.class]} href={href} target="_blank" rel="noopener">
      <Image
        src={badge}
        alt={`${verb} ${label} (opens in a new tab)`}
        height={badgeH}
        width={Math.round((badge.width / badge.height) * badgeH)}
        class="store-badge"
        style={`height:${badgeH}px`}
        loading="lazy"
      />
    </a>
  ) : (
    <a
      class:list={["store-btn", `store-btn--${variant}`, `store-btn--${size}`, props.class]}
      href={href}
      target="_blank"
      rel="noopener"
    >
      {mark && <Icon name={mark} size={size === "sm" ? 20 : 24} class="store-mark" />}
      <span class="store-text">
        <span class="store-verb">{verb}</span>
        <span class="store-label">{label}</span>
        <span class="visually-hidden"> (opens in a new tab)</span>
      </span>
      {!mark && <Icon name="arrowUpRight" size={size === "sm" ? 16 : 18} class="store-arrow" />}
    </a>
  )
}

<style>
  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.5rem 1.4rem 0.5rem 1.15rem;
    border-radius: var(--lw-radius-pill);
    border: 1px solid var(--lw-border-strong);
    background: transparent;
    color: var(--lw-ink);
    text-decoration: none;
    line-height: 1.1;
    transition: transform var(--lw-fast) ease, border-color var(--lw-fast) ease, background-color var(--lw-fast) ease,
      box-shadow var(--lw-fast) ease, color var(--lw-fast) ease;
  }
  .store-btn:hover {
    color: var(--lw-ink);
    transform: translateY(-1px);
    border-color: var(--lw-accent-line);
    background: var(--lw-accent-tint);
  }
  .store-btn--primary {
    border-color: transparent;
    background: var(--lw-btn-bg);
    color: var(--lw-btn-ink);
    box-shadow: var(--lw-btn-glow);
  }
  .store-btn--primary:hover {
    color: var(--lw-btn-ink);
    background: var(--lw-btn-bg-hover);
    border-color: transparent;
  }
  .store-btn--sm {
    min-height: 46px;
    padding: 0.35rem 1.1rem 0.35rem 0.9rem;
    gap: 0.6rem;
  }
  .store-btn :global(.store-mark) {
    flex-shrink: 0;
  }
  .store-text {
    display: flex;
    flex-direction: column;
    gap: 0.14rem;
    text-align: left;
  }
  .store-verb {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    opacity: 0.78;
  }
  .store-label {
    font-family: var(--lw-font-display);
    font-weight: 600;
    font-size: 1.06rem;
    white-space: nowrap;
  }
  .store-btn--sm .store-label {
    font-size: 0.95rem;
  }
  .store-btn--sm .store-verb {
    font-size: 0.68rem;
  }
  .store-btn :global(.store-arrow) {
    flex-shrink: 0;
    opacity: 0.7;
    transition: transform var(--lw-fast) ease, opacity var(--lw-fast) ease;
  }
  .store-btn:hover :global(.store-arrow) {
    opacity: 1;
    transform: translate(2px, -2px);
  }
  .store-badge-link {
    display: inline-block;
    border-radius: 8px;
    line-height: 0;
    transition: transform var(--lw-fast) ease;
  }
  .store-badge-link:hover {
    transform: translateY(-1px);
  }
  .store-badge {
    display: block;
    width: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .store-btn:hover,
    .store-badge-link:hover {
      transform: none;
    }
  }
</style>
