---
/**
 * Home hero: the studio's animated splash behind the offer.
 *
 * What paints first is a <picture> of the video's first frame (sky only): art-directed, the
 * 9:16 still in portrait and the 16:9 still otherwise, AVIF then WebP, eager and high
 * priority. Under prefers-reduced-motion the same <picture> serves the settled frame with the
 * emblem instead, with no script. Without JavaScript a <noscript> copy of the settled frame
 * covers the first one.
 *
 * After the window's load event the inline script below adds the splash video over the still
 * (same box, same object-fit and object-position, so the hand-off does not move), unless
 * Save-Data is on or the connection is 2G. If the video cannot start (play() refused, an
 * error, or no `playing` within a few seconds) the settled still is shown instead. The video
 * never loops from 0: on `ended` it seeks to loopStart (hero.json), where every file has a
 * keyframe. It pauses while the hero is off screen or the tab is hidden.
 *
 * The settled still lives in a <template>, so it is valid markup and nothing is fetched until
 * the script clones it in.
 *
 * The idle loop runs on, so a button in the hero's bottom-right corner pauses it (WCAG 2.2.2).
 * It appears only once the video plays. The choice is kept in localStorage ("lw-motion" =
 * "paused"): a visitor who paused gets the settled still on later visits, with no video
 * download, and the same button (now "Play") resumes the loop.
 *
 * Largest paint: the video box is inset 2 px inside the still's box, and the landscape still
 * is sized to the width its cover crop really renders at, so the first video frame is never
 * a larger LCP candidate than the still that is already painted.
 *
 * Media and timings: archive/research/hero-media.md, src/assets/hero/hero.json.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../Icon.astro";
import desktopFirst from "../../assets/hero/hero-desktop-first.png";
import desktopFinal from "../../assets/hero/hero-desktop-final.png";
import mobileFirst from "../../assets/hero/hero-mobile-first.png";
import mobileFinal from "../../assets/hero/hero-mobile-final.png";
import hero from "../../assets/hero/hero.json";

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  proof?: string[];
}
const { title, lead, eyebrow, proof = [] } = Astro.props;

/* One media query decides the art in CSS, in the <picture>, and in the script. */
const PORTRAIT = "(orientation: portrait)";
const REDUCE = "(prefers-reduced-motion: reduce)";

const DESKTOP_W = [960, 1440, 1920, 2560];
const MOBILE_W = [480, 720, 860, 1080];

/* Landscape: the 16:9 art covers a hero that is 94svh tall (560 to 900 px), so it renders at
   least 1.67 viewport heights wide. Portrait art is drawn at the viewport's width. */
const PORTRAIT_SIZES = "100vw";
const LANDSCAPE_SIZES = "max(100vw, clamp(996px, 167vh, 1600px))";

type Fmt = "avif" | "webp";
/* Checked with the darks stretched 3x: below these the fog starts to block up. The first
   still stays far under the 60 KB budget at 1920 wide (see the report). */
const QUALITY: Record<Fmt, number> = { avif: 70, webp: 80 };

async function srcset(src: ImageMetadata, widths: number[], format: Fmt) {
  const out = await Promise.all(widths.map((width) => getImage({ src, width, format, quality: QUALITY[format] })));
  return out.map((img, i) => `${img.src} ${widths[i]}w`).join(", ");
}
async function set(src: ImageMetadata, widths: number[]) {
  return { avif: await srcset(src, widths, "avif"), webp: await srcset(src, widths, "webp") };
}

const [dFirst, dFinal, mFirst, mFinal] = await Promise.all([
  set(desktopFirst, DESKTOP_W),
  set(desktopFinal, DESKTOP_W),
  set(mobileFirst, MOBILE_W),
  set(mobileFinal, MOBILE_W),
]);
const fallbackFirst = await getImage({ src: desktopFirst, width: 1920, format: "webp", quality: QUALITY.webp });
const fallbackFinal = await getImage({ src: desktopFinal, width: 1920, format: "webp", quality: QUALITY.webp });

/* The settled frame as <source> elements (in the <template> and the <noscript> copy). */
const finalSources = [
  { media: PORTRAIT, type: "image/avif", srcset: mFinal.avif, sizes: PORTRAIT_SIZES },
  { media: PORTRAIT, type: "image/webp", srcset: mFinal.webp, sizes: PORTRAIT_SIZES },
  { type: "image/avif", srcset: dFinal.avif, sizes: LANDSCAPE_SIZES },
  { type: "image/webp", srcset: dFinal.webp, sizes: LANDSCAPE_SIZES },
];

const loopStart = hero.desktop.loopStart;
---

<section class="hero bleed-under-header" data-theme="dark" aria-labelledby="hero-title">
  <div class="hero-media" id="hero-media">
    <picture class="hero-still">
      <source media={`${REDUCE} and ${PORTRAIT}`} type="image/avif" srcset={mFinal.avif} sizes={PORTRAIT_SIZES} />
      <source media={`${REDUCE} and ${PORTRAIT}`} type="image/webp" srcset={mFinal.webp} sizes={PORTRAIT_SIZES} />
      <source media={REDUCE} type="image/avif" srcset={dFinal.avif} sizes={LANDSCAPE_SIZES} />
      <source media={REDUCE} type="image/webp" srcset={dFinal.webp} sizes={LANDSCAPE_SIZES} />
      <source media={PORTRAIT} type="image/avif" srcset={mFirst.avif} sizes={PORTRAIT_SIZES} />
      <source media={PORTRAIT} type="image/webp" srcset={mFirst.webp} sizes={PORTRAIT_SIZES} />
      <source type="image/avif" srcset={dFirst.avif} sizes={LANDSCAPE_SIZES} />
      <source type="image/webp" srcset={dFirst.webp} sizes={LANDSCAPE_SIZES} />
      <img
        src={fallbackFirst.src}
        alt=""
        width={desktopFirst.width}
        height={desktopFirst.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    {/* Cloned in by the script when the video is skipped, fails, or was paused on an earlier visit. */}
    <template id="hero-final">
      <picture class="hero-still hero-final">
        {finalSources.map((s) => <source {...s} />)}
        <img src={fallbackFinal.src} alt="" width={desktopFinal.width} height={desktopFinal.height} decoding="async" />
      </picture>
    </template>

    <noscript>
      <picture class="hero-still">
        {finalSources.map((s) => <source {...s} />)}
        <img src={fallbackFinal.src} alt="" width={desktopFinal.width} height={desktopFinal.height} decoding="async" />
      </picture>
    </noscript>
  </div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
      <h1 id="hero-title" class="hero-title">{title}</h1>
      <p class="hero-lead">{lead}</p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--lg" href="/contact/">
          Start a project <Icon name="arrowRight" size={18} />
        </a>
        <a class="btn btn--secondary btn--lg hero-secondary" href="/games/">See our work</a>
      </div>
      {
        proof.length > 0 && (
          <ul class="hero-proof" role="list" aria-label="Studio highlights">
            {proof.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  {/* Shown by the script once the video plays. The hidden label and the icon swap together. */}
  <button type="button" class="hero-motion" id="hero-motion" hidden>
    <span class="visually-hidden" id="hero-motion-label">Pause background animation</span>
    <Icon name="pause" size={18} class="hm-icon hm-pause" />
    <Icon name="play" size={18} class="hm-icon hm-play" />
  </button>
</section>

<script is:inline define:vars={{ loopStart, PORTRAIT, REDUCE }}>
  (function () {
    var box = document.getElementById("hero-media");
    if (!box || matchMedia(REDUCE).matches) return;

    var finalShown = false;
    function showFinal() {
      if (finalShown) return;
      finalShown = true;
      var tpl = document.getElementById("hero-final");
      if (tpl && tpl.content) box.appendChild(tpl.content.cloneNode(true));
    }

    var c = navigator.connection;
    if (c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || ""))) {
      showFinal();
      return;
    }

    /* Pause and play: the visitor's choice wins over everything below. */
    var KEY = "lw-motion";
    var btn = document.getElementById("hero-motion");
    var label = document.getElementById("hero-motion-label");
    var userPaused = false;
    var v = null;
    try {
      userPaused = localStorage.getItem(KEY) === "paused";
    } catch (e) {}
    function remember(paused) {
      try {
        if (paused) localStorage.setItem(KEY, "paused");
        else localStorage.removeItem(KEY);
      } catch (e) {}
    }
    function showButton(paused) {
      if (!btn) return;
      btn.classList.toggle("is-paused", paused);
      label.textContent = paused ? "Play background animation" : "Pause background animation";
      btn.hidden = false;
    }
    if (btn) {
      btn.addEventListener("click", function () {
        userPaused = !userPaused;
        remember(userPaused);
        showButton(userPaused);
        if (userPaused) {
          if (v) v.pause();
        } else if (v) {
          v.play().catch(function () {});
        } else {
          start(true);
        }
      });
    }

    /* Paused on an earlier visit: the settled still, no video until Play is pressed. */
    if (userPaused) {
      showFinal();
      showButton(true);
      return;
    }

    /* `resume`: started by the Play button after the settled still, so skip the intro. */
    function start(resume) {
      var portrait = matchMedia(PORTRAIT).matches;
      var base = portrait ? "/media/hero-mobile" : "/media/hero-desktop";
      var vid = (v = document.createElement("video"));
      vid.muted = true;
      vid.defaultMuted = true;
      vid.playsInline = true;
      vid.setAttribute("muted", "");
      vid.setAttribute("playsinline", "");
      vid.setAttribute("aria-hidden", "true");
      vid.setAttribute("tabindex", "-1");
      vid.disablePictureInPicture = true;
      vid.preload = "auto";
      vid.className = "hero-video " + (portrait ? "is-portrait" : "is-landscape");
      var last;
      [["webm", "video/webm"], ["mp4", "video/mp4"]].forEach(function (f) {
        last = document.createElement("source");
        last.src = base + "." + f[0] + (resume ? "#t=" + loopStart : "");
        last.type = f[1];
        vid.appendChild(last);
      });

      var state = "loading"; // loading | playing | failed
      var visible = true;
      function fail() {
        if (state !== "loading") return;
        state = "failed";
        clearTimeout(timer);
        vid.pause();
        vid.removeAttribute("src");
        vid.remove();
        v = null;
        showFinal();
        if (btn) btn.hidden = true; // nothing left to pause or play
      }
      // A visitor who pauses while the file is still loading has not seen it fail.
      function failUnlessPaused() {
        if (!userPaused) fail();
      }
      var timer = setTimeout(failUnlessPaused, 5000);

      vid.addEventListener("playing", function () {
        if (state !== "loading") return;
        state = "playing";
        clearTimeout(timer);
        box.classList.add("is-playing");
        showButton(userPaused);
        sync();
      });
      vid.addEventListener("error", fail);
      last.addEventListener("error", fail); // every source failed
      // Never replay the intro: hold the idle loop from loopStart (a keyframe in every file).
      vid.addEventListener("ended", function () {
        if (userPaused) return;
        vid.currentTime = loopStart;
        vid.play().catch(function () {});
      });

      function sync() {
        if (state !== "playing") return;
        if (visible && !document.hidden && !userPaused) vid.play().catch(function () {});
        else vid.pause();
      }
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (entries) {
          visible = entries[entries.length - 1].isIntersecting;
          sync();
        }).observe(box);
      }
      document.addEventListener("visibilitychange", sync);

      box.appendChild(vid);
      var p = vid.play();
      if (p && p.catch) p.catch(failUnlessPaused);
    }

    // Only once the still is decoded and painted, so it is always the largest paint.
    function startOnLoad() {
      var still = box.querySelector(".hero-still img");
      var ready = still && still.decode ? still.decode() : Promise.resolve();
      ready.then(go, go);
      function go() {
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            start(false);
          });
        });
      }
    }
    if (document.readyState === "complete") startOnLoad();
    else addEventListener("load", startOnLoad, { once: true });
  })();
</script>

<style>
  .hero {
    --hero-pos: 72% 50%;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 94svh, 900px);
    overflow: hidden;
    background: #04070a;
    color: var(--lw-ink);
  }

  /* One fixed box for the still and the video: the video never shifts anything. */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #04070a;
  }
  .hero-media :global(picture),
  .hero-media :global(img),
  .hero-media :global(.hero-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img),
  .hero-media :global(.hero-video) {
    object-fit: cover;
    object-position: var(--hero-pos);
  }
  /* 2 px inside the still on every side, so its first frame is never a larger paint than the
     still (the largest paint stays the image in the HTML). The edge shows the same sky. */
  .hero-media :global(.hero-video) {
    inset: 2px;
    width: calc(100% - 4px);
    height: calc(100% - 4px);
    opacity: 0;
  }
  .hero-media:global(.is-playing) :global(.hero-video) {
    opacity: 1;
  }
  .hero-media :global(.hero-video.is-landscape) {
    object-position: 72% 50%;
  }
  .hero-media :global(.hero-video.is-portrait) {
    object-position: 50% 30%;
  }
  /* The art's lower edge melts into the section's night colour (matters in portrait, where
     the 9:16 box can end above the bottom of the section). */
  .hero-media::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 18%;
    background: linear-gradient(to bottom, rgba(4, 7, 10, 0), #04070a);
    pointer-events: none;
  }

  /* Scrims: as light as legibility needs. The sky behind the text is already dark. */
  .hero::before,
  .hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero::before {
    inset: 0;
    background: linear-gradient(to right, rgba(4, 7, 10, 0.5), rgba(4, 7, 10, 0.18) 42%, transparent 62%);
  }
  /* The last stretch fades into the night colour, so the hero never ends on a hard edge. */
  .hero::after {
    bottom: 0;
    height: 120px;
    background: linear-gradient(to bottom, rgba(4, 7, 10, 0), #04070a);
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(2.5rem, 6vh, 4.5rem);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
    max-width: min(620px, calc(50vw - var(--lw-gutter)));
  }
  .hero-eyebrow {
    color: #81ebe1;
  }
  .hero-title {
    font-size: clamp(2.4rem, 1.5rem + 3.3vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #f4fbfb;
  }
  .hero-lead {
    font-size: clamp(1.08rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: #c4d6d9;
    max-width: 52ch;
    text-wrap: balance; /* no single word left alone on the last line */
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .hero-secondary {
    background: rgba(4, 7, 10, 0.35);
  }
  /* One point per line at every width, so they never wrap two and one. */
  .hero-proof {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0.6rem 0 0;
    padding: 0;
    font-size: var(--lw-text-sm);
    color: #a9c0c4;
  }
  .hero-proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  /* Each point leads with a small moon, so a wrapped line never starts on a separator. */
  .hero-proof li::before {
    content: "";
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #81ebe1;
    box-shadow: 0 0 6px rgba(129, 235, 225, 0.6);
  }

  /* Pause / play for the background loop: the video cards' round dark button, in the corner. */
  .hero-motion {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(238, 247, 247, 0.32);
    background: rgba(4, 7, 10, 0.74);
    color: #eef7f7;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .hero-motion[hidden] {
    display: none;
  }
  .hero-motion:hover {
    background: #81ebe1;
    color: #04070a;
  }
  .hero-motion:focus-visible {
    outline: 2px solid #81ebe1;
    outline-offset: 3px;
    border-radius: 50%;
  }
  .hero-motion :global(.hm-play),
  .hero-motion.is-paused :global(.hm-pause) {
    display: none;
  }
  .hero-motion.is-paused :global(.hm-play) {
    display: block;
    margin-left: 2px;
  }

  /* Portrait (phones, tablets held upright): the 9:16 art. The emblem fills the top, the
     copy sits in the lower half over the quiet sky. The art keeps its own 9:16 box from the
     top, so a tall phone does not blow the emblem up behind the text; below it the section's
     night colour continues. */
  @media (orientation: portrait) {
    .hero {
      --hero-pos: 50% 30%;
      align-items: flex-end;
      min-height: min(100svh, 1180px);
    }
    /* Full width, 9:16 tall, never taller than the section (aspect-ratio with max-height
       would narrow the box instead). */
    .hero-media {
      bottom: auto;
      height: min(100%, 177.78vw);
    }
    .hero::before {
      top: auto;
      bottom: 0;
      height: 62%;
      background: linear-gradient(to bottom, rgba(4, 7, 10, 0), rgba(4, 7, 10, 0.55) 45%, rgba(4, 7, 10, 0.8));
    }
    .hero-inner {
      padding-block: 0 clamp(1.75rem, 5vh, 3.5rem);
    }
    .hero-copy {
      max-width: 640px;
    }
  }
  @media (orientation: portrait) and (max-width: 640px) {
    /* The copy ends above the pause button, so the two never meet on a narrow phone. */
    .hero-inner {
      padding-bottom: calc(44px + 1.5rem);
    }
    .hero-copy {
      gap: 0.9rem;
    }
    .hero-title {
      font-size: clamp(2.1rem, 1.3rem + 4.4vw, 2.6rem);
    }
    .hero-lead {
      font-size: 1.04rem;
    }
    .hero-actions {
      width: 100%;
    }
    .hero-actions .btn {
      flex: 1 1 auto;
      font-size: 1rem;
      padding-inline: 1.2em;
    }
    .hero-proof {
      margin-top: 0.25rem;
      font-size: 0.82rem;
    }
    .hero-eyebrow {
      letter-spacing: 0.1em;
    }
    .hero-eyebrow::before {
      display: none;
    }
  }
</style>
