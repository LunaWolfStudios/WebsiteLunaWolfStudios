---
/**
 * Tools and platforms for a service, as labelled rows of chips. Only names the archive gives.
 *
 *   <StackChips groups={[{ label: "Engines", items: ["Unity", "C#"] }]} />
 */
interface Props {
  groups: Array<{ label: string; items: string[] }>;
  class?: string;
}

const { groups, class: cls } = Astro.props;
---

<div class:list={["stack-rows", cls]}>
  {
    groups.map((group, i) => (
      <div class="stack-row" data-reveal style={`--reveal-delay:${i * 50}ms`}>
        <h3 class="stack-label">{group.label}</h3>
        <ul class="stack-chips" role="list">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .stack-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--lw-border);
  }
  .stack-row {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 0.75rem 2rem;
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--lw-border);
  }
  .stack-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--lw-ink);
  }
  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .stack-chips li {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.3;
    padding: 0.38em 0.85em;
    border-radius: var(--lw-radius-pill);
    border: 1px solid var(--lw-border-strong);
    background: var(--lw-surface);
    color: var(--lw-ink);
  }
  @media (max-width: 640px) {
    .stack-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
  }
</style>
