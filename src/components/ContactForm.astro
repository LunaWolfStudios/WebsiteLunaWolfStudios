---
/**
 * Contact form for /contact/ (and anywhere else a page wants the full form).
 *
 *   <ContactForm />
 *   <ContactForm topic="Publishing" />        preselects "What can we help with?"
 *
 * Sends name, email, company, topic and message to the studio inbox through the FormSubmit
 * relay configured in src/data/site.ts (FORMS.contact). With JavaScript the message goes as
 * JSON to the AJAX endpoint and the result appears inline; without it the form posts to the
 * plain endpoint and FormSubmit redirects back to /contact/?sent=1, which shows the same
 * success message. A honeypot field (_honey) catches bots; FormSubmit's captcha page is off.
 */
import Icon from "./Icon.astro";
import FormStatus from "./FormStatus.astro";
import { FORMS, SITE, plainEndpoint } from "../data/site";

export const TOPICS = [
  "Game development",
  "Unity tools",
  "VR or AR",
  "Serious games or training",
  "Software or web app",
  "Publishing",
  "Internship or bootcamp",
  "Press",
  "Something else",
] as const;

interface Props {
  /** Preselected topic, one of TOPICS. */
  topic?: (typeof TOPICS)[number];
  /** Where FormSubmit sends a no-JS visitor after sending. */
  returnTo?: string;
  id?: string;
  class?: string;
}

const { topic, returnTo = "/contact/", id = "contact-form", class: cls } = Astro.props;
const next = new URL(`${returnTo}?sent=1`, SITE.url).href;
---

<form
  id={id}
  class:list={["contact-form", cls]}
  method="POST"
  action={plainEndpoint(FORMS.contact.endpoint)}
  data-lw-form="contact"
  data-endpoint={FORMS.contact.endpoint}
  data-mode="relay"
>
  <input type="hidden" name="_subject" value="Website contact" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={next} />
  <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <p class="cf-req">All fields are required except company.</p>
  <div class="cf-grid">
    <div class="field">
      <label class="field-label" for={`${id}-name`}>Name</label>
      <input class="input" id={`${id}-name`} name="name" type="text" autocomplete="name" required maxlength="120" />
    </div>
    <div class="field">
      <label class="field-label" for={`${id}-email`}>Email</label>
      <input
        class="input"
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        maxlength="200"
      />
    </div>
    <div class="field">
      <label class="field-label" for={`${id}-company`}>
        Company or studio <span class="optional">(optional)</span>
      </label>
      <input class="input" id={`${id}-company`} name="company" type="text" autocomplete="organization" maxlength="160" />
    </div>
    <div class="field">
      <label class="field-label" for={`${id}-topic`}>What can we help with?</label>
      <select class="input" id={`${id}-topic`} name="topic" required>
        <option value="" disabled selected={!topic}>Choose one</option>
        {TOPICS.map((t) => <option selected={t === topic}>{t}</option>)}
      </select>
    </div>
    <div class="field cf-full">
      <label class="field-label" for={`${id}-message`}>Message</label>
      <textarea
        class="input"
        id={`${id}-message`}
        name="message"
        rows="6"
        required
        maxlength="5000"
        placeholder="Tell us about the project: goals, platforms, timeline, and budget if you have one."
      ></textarea>
    </div>
  </div>

  <div class="cf-actions">
    <button type="submit" class="btn btn--primary btn--lg" data-submit data-busy-label="Sending…">
      <span data-label>Send message</span>
      <Icon name="send" size={18} />
    </button>
    <p class="cf-note">
      Prefer email? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </div>

  <FormStatus />
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .cf-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1.25rem;
  }
  .cf-full {
    grid-column: 1 / -1;
  }
  .cf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .cf-note,
  .cf-req {
    font-size: var(--lw-text-sm);
    color: var(--lw-ink-muted);
  }
  .cf-req {
    margin-bottom: -0.35rem;
  }
  @media (max-width: 640px) {
    .cf-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cf-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { enhanceForm, showReturnSuccess } from "../scripts/forms";

  const success = (name?: string) =>
    `Thanks${name ? `, ${name.split(" ")[0]}` : ""}. Your message is on its way, and we will reply by email.`;

  document.querySelectorAll<HTMLFormElement>('form[data-lw-form="contact"]').forEach((form) => {
    enhanceForm(form, {
      success: (data) => success(data.name),
      // FormStatus adds "You can also email us at ..." under an error, so the address is not repeated here.
      failure: "Sorry, the message did not send. Try again in a moment.",
      prepare: (data) => {
        data._subject = `Website contact: ${data.topic || "General"}${data.name ? ` from ${data.name}` : ""}`;
      },
    });
    showReturnSuccess(form, "sent", success());
  });
</script>
