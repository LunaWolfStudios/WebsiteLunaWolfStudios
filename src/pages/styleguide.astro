<script>
  // QA hooks for screenshots and manual testing. This page only.
  const params = new URLSearchParams(location.search);
  const formtest = params.get("formtest");
  if (formtest) {
    const real = window.fetch.bind(window);
    window.fetch = async (input, init) => {
      const url = String(input instanceof Request ? input.url : input);
      if (/formsubmit\.co/.test(url)) {
        await new Promise((r) => setTimeout(r, 300));
        return new Response(JSON.stringify(formtest === "ok" ? { success: "true" } : { success: "false" }), {
          status: formtest === "ok" ? 200 : 500,
          headers: { "Content-Type": "application/json" },
        });
      }
      return real(input, init);
    };
    addEventListener("load", () => {
      const c = document.getElementById("sg-contact") as HTMLFormElement | null;
      if (c) {
        (c.elements.namedItem("name") as HTMLInputElement).value = "Test Person";
        (c.elements.namedItem("email") as HTMLInputElement).value = "test@example.com";
        (c.elements.namedItem("topic") as HTMLSelectElement).value = "Unity tools";
        (c.elements.namedItem("message") as HTMLTextAreaElement).value = "Stubbed submission.";
        c.requestSubmit();
      }
      const n = document.getElementById("sg-newsletter") as HTMLFormElement | null;
      if (n) {
        (n.querySelector('input[type="email"]') as HTMLInputElement).value = "test@example.com";
        n.requestSubmit();
      }
    });
  }
  const open = params.get("open");
  addEventListener("load", () => {
    if (open === "video") document.querySelector<HTMLElement>("#videos a[data-video-id]")?.click();
    if (open === "lightbox") document.querySelector<HTMLElement>(".gal-thumb")?.click();
    if (open === "menu") document.getElementById("nav-toggle")?.click();
    if (open === "services") document.querySelector<HTMLElement>(".nav-desktop .nav-link")?.focus();
    // ?qa=overflow lists elements that stick out past the viewport (horizontal scroll bugs).
    if (params.get("qa") === "overflow") {
      const vw = document.documentElement.clientWidth;
      const bad = [...document.querySelectorAll<HTMLElement>("body *")]
        .filter((el) => {
          const r = el.getBoundingClientRect();
          return r.width > 0 && (r.right > vw + 1 || r.left < -1) && !el.closest("dialog, .reviews--row, .visually-hidden, .hp");
        })
        .map((el) => `${el.tagName.toLowerCase()}.${[...el.classList].join(".")} right=${Math.round(el.getBoundingClientRect().right)}`);
      const report = `vw=${vw} scrollW=${document.documentElement.scrollWidth} :: ${bad.slice(0, 20).join(" | ") || "none"}`;
      document.body.dataset.overflow = report;
      if (parent !== window) parent.postMessage({ overflow: report }, "*");
    }
  });
</script>
