      "quotes": [
        { "text": "Take some mushrooms, turn out all the lights, blast the music, and just zone out for a good long while", "attribution": "MIVS Judge 2025", "source": "archive/wordpress/pages/hypno-halo.md", "verified": false },
        { "text": "This game is an absolute TRIP and I hate how addicting it is xD. Even when my fingers were exhausted, I kept playing because it was tons of fun. The music was sufficiently epic to inspire me to keep playing & trying my hardest", "attribution": "MIVS Judge 2025", "source": "archive/wordpress/pages/hypno-halo.md", "verified": false },
        { "text": "Hypno Halo mesmerizes with minimalist design and pure mechanics. The loop feels meditative and addictive. Halo aesthetics soothe and pull you into chasing high scores…", "attribution": "OFEN™", "url": "https://steamcommunity.com/groups/O-F-E-N/curation/app/3847950/", "source": "archive/wordpress/pages/hypno-halo.md", "verified": false },
        { "text": "Maddeningly simple. Press buttons to match coloured halos before they vanish. Love how it gets faster before adding a new colour in, slowing down, and then ramping up again. Flow state gaming glory.", "attribution": "Higher Plain Games (Steam Curator, Recommended)", "url": "https://store.steampowered.com/curators/curatorsreviewing/?appid=3847950", "verified": true }
      ],
