---
/**
 * The page shell: <head> (SEO, social cards, theme, fonts, JSON-LD), header, main, footer,
 * the shared video theater, and the scroll-reveal script. Every page renders inside it.
 *
 *   <BaseLayout
 *     title="Unity development services"          // " | Luna Wolf Studios" is appended
 *     description="140 to 160 characters ..."
 *     breadcrumbs={[{ label: "Services", href: "/services/" }, { label: "Unity development", href: "/services/unity-development/" }]}
 *     jsonLd={serviceLd({ ... })}
 *   >
 *     <PageHero ... />
 *     <Section ...>...</Section>
 *   </BaseLayout>
 *
 * Props
 * - title: the page's subject in search words, up to ~40 characters; the brand suffix is
 *   added unless the title already names the studio. Full title stays under 60.
 * - brandSuffix: false prints the title as given, for a product page whose own name and
 *   search phrase need all 60 characters ("Scriptable Sheets: edit ScriptableObjects ...").
 * - description: 140 to 160 characters, unique per page.
 * - image: Open Graph image, a public path ("/og-default.png", the default) or an imported
 *   image (rendered to a 1200px wide JPEG).
 * - noindex: robots noindex and no canonical (404, styleguide).
 * - headerOverlay: transparent header over a dark full-bleed first section; that section
 *   should carry `.bleed-under-header`.
 * - breadcrumbs: trail without Home (prepended). Renders the visible trail unless
 *   hideBreadcrumbs, and always emits BreadcrumbList JSON-LD.
 * - jsonLd: one node or an array, from src/lib/seo.ts builders. Merged with Organization and
 *   WebSite into one @graph.
 * - ogType: "website" (default), "article", "profile", "video.other" ...
 * - footerNewsletter: false leaves the signup band out of the footer, for a page whose own
 *   last section is a newsletter form (/newsletter/, /scriptable-sheets/). One form per page.
 * - slot "head": extra head tags.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import outfitLatinExt from "@fontsource-variable/outfit/files/outfit-latin-ext-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import interLatinExt from "@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Theater from "../components/Theater.astro";
import { SITE, ANALYTICS } from "../data/site";
import { breadcrumbLd, graph, organizationLd, webSiteLd, type JsonLd } from "../lib/seo";
import { IS_PREVIEW, sitePath } from "../lib/base";

interface Props {
  title?: string;
  brandSuffix?: boolean;
  description?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  headerOverlay?: boolean;
  breadcrumbs?: Array<{ label: string; href: string }>;
  hideBreadcrumbs?: boolean;
  jsonLd?: JsonLd | JsonLd[];
  ogType?: string;
  footerNewsletter?: boolean;
}

const {
  title,
  brandSuffix = true,
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt,
  noindex = false,
  headerOverlay = false,
  breadcrumbs,
  hideBreadcrumbs = false,
  jsonLd,
  ogType = "website",
  footerNewsletter = true,
} = Astro.props;

const fullTitle = !title ? SITE.title : !brandSuffix || /luna wolf/i.test(title) ? title : `${title} | ${SITE.name}`;
// The production address. A preview build moves it to the preview origin after the build
// (scripts/rebase-dist.mjs), which is why the base is stripped here and not doubled there.
const canonical = new URL(sitePath(Astro.url.pathname), SITE.url).href;

// Open Graph image: public path or an imported image rendered to a 1200px JPEG.
let og: { url: string; width: number; height: number } = {
  url: new URL(SITE.ogImage, SITE.url).href,
  width: SITE.ogImageWidth,
  height: SITE.ogImageHeight,
};
if (typeof image === "string") {
  og = image === SITE.ogImage ? og : { url: new URL(image, SITE.url).href, width: 0, height: 0 };
} else if (image) {
  const width = Math.min(1200, image.width);
  const rendered = await getImage({ src: image, width, format: "jpg", quality: 82 });
  og = {
    url: new URL(rendered.src, SITE.url).href,
    width,
    height: Math.round((image.height * width) / image.width),
  };
}

const trail = breadcrumbs?.length
  ? breadcrumbs[0].href === "/"
    ? breadcrumbs
    : [{ label: "Home", href: "/" }, ...breadcrumbs]
  : undefined;

const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ld = graph([organizationLd(), webSiteLd(), ...(trail ? [breadcrumbLd(trail)] : []), ...pageNodes]);

/* Theme before first paint. Dark unless the visitor chose light; ?theme= wins for this view
   (QA hook). Also marks the document as scripted, so reveal styles only hide what a script
   will bring back, and, when the address points at a section (#id), asks for the whole page
   to be laid out so the jump lands on it (.lay-all, see global.css). */
const themeScript = `(function(){var d=document.documentElement,t=null;try{var q=new URLSearchParams(location.search).get("theme");t=q==="light"||q==="dark"?q:localStorage.getItem("lw-theme")}catch(e){}t=t==="light"?"light":"dark";d.dataset.theme=t;d.classList.add("js");if(location.hash.length>1)d.classList.add("lay-all");var m=document.querySelector('meta[name="theme-color"]');if(m)m.content=t==="light"?"${SITE.themeColor.light}":"${SITE.themeColor.dark}"})();`;

/* Fonts: latin and latin-ext subsets only, declared here so the preloaded URLs and the
   @font-face URLs are the same hashed files. The fallback faces are Arial scaled to each
   font's metrics (computed with @capsizecss/unpack), so the swap does not move the layout.
   Outfit is used almost only at weight 600 to 650, where it runs wider than its regular
   weight, so its fallback is sized to the headings as set (measured over every h1 to h3 on
   the site: 101.1% makes fallback and real widths agree within 0.5%; the capsize value for
   the regular weight, 99.15%, left headings 2% narrow and some gained a line on the swap).
   The ascent and descent overrides are the capsize ones rescaled to that size. */
const fontCss = `
@font-face{font-family:"Outfit Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${outfitLatin}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Outfit Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${outfitLatinExt}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:"Inter Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Inter Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatinExt}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:"Outfit Fallback";src:local("Arial"),local("ArialMT"),local("Helvetica"),local("Liberation Sans");size-adjust:101.1%;ascent-override:98.92%;descent-override:25.71%;line-gap-override:0%}
@font-face{font-family:"Inter Fallback";src:local("Arial"),local("ArialMT"),local("Helvetica"),local("Liberation Sans");size-adjust:107.12%;ascent-override:90.44%;descent-override:22.52%;line-gap-override:0%}
`.trim();

/* Analytics, only when a provider is configured, and only after load and an idle moment. */
const whenIdle = (body: string) =>
  `addEventListener("load",function(){(window.requestIdleCallback||function(f){setTimeout(f,1200)})(function(){${body}},{timeout:4000})});`;
const analyticsScript =
  ANALYTICS.provider === "goatcounter" && ANALYTICS.goatcounterCode
    ? whenIdle(
        `var s=document.createElement("script");s.async=true;s.src="https://gc.zgo.at/count.js";s.dataset.goatcounter=${JSON.stringify(`https://${ANALYTICS.goatcounterCode}.goatcounter.com/count`)};document.head.appendChild(s)`,
      )
    : ANALYTICS.provider === "metricool" && ANALYTICS.metricoolHash
      ? whenIdle(
          `var s=document.createElement("script");s.src="https://tracker.metricool.com/resources/be.js";s.async=true;s.onload=function(){window.beTracker&&beTracker.t({hash:${JSON.stringify(ANALYTICS.metricoolHash)}})};document.head.appendChild(s)`,
        )
      : "";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor.dark} />
    <script is:inline set:html={themeScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* No canonical on noindex pages: the 404 is served for every bad path. A preview build
        (github.io, before the domain is attached) is noindex on every page and carries no
        canonical either: a canonical beside noindex sends search engines mixed signals, and
        one aimed at the real domain would point at whatever that domain serves today. Its
        og:url stays, so a shared preview link unfurls at the preview address. */}
    {noindex || IS_PREVIEW ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og.url} />
    {og.width > 0 && <meta property="og:image:width" content={String(og.width)} />}
    {og.height > 0 && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:alt" content={imageAlt ?? `${SITE.name}: ${SITE.tagline}`} />
    {/* A wide image gets the large card; a square or portrait one (a headshot, an icon)
        would lose its top and bottom there, so it gets the small card. Width 0 means a
        public-path image of unknown size, which is treated as wide. */}
    <meta
      name="twitter:card"
      content={og.width === 0 || (og.width >= 1200 && og.height <= og.width * 0.6) ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:site" content="@lunawolfstudios" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />

    <script type="application/ld+json" is:inline set:html={ld} />
    <slot name="head" />
    {analyticsScript && <script is:inline set:html={analyticsScript} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header overlay={headerOverlay} />
    <main id="main" tabindex="-1" class:list={[{ "has-crumbs": trail && !hideBreadcrumbs }]}>
      {
        trail && !hideBreadcrumbs && (
          <div class="wrap crumbs-wrap">
            <Breadcrumbs items={trail} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer newsletter={footerNewsletter} />
    <Theater />

    <script>
      // A click on a link to a section of this page: lay the whole page out first (.lay-all in
      // global.css), so the browser scrolls to where the section really is. Capture phase, so
      // the class is on before the jump.
      document.addEventListener(
        "click",
        (e) => {
          const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href*="#"]');
          if (!link) return;
          const url = new URL(link.href, location.href);
          if (url.hash.length > 1 && url.pathname === location.pathname) document.documentElement.classList.add("lay-all");
        },
        true,
      );

      // Walk each [data-reveal] block in as it reaches the viewport. When its animation ends
      // the element is marked shown and the animation class comes off, so nothing is left
      // pinned by animation fill (which would block the hover lift on cards).
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (targets.length) {
        const show = (el: HTMLElement) => {
          el.addEventListener(
            "animationend",
            () => {
              el.classList.add("is-shown");
              el.classList.remove("is-in");
            },
            { once: true },
          );
          el.classList.add("is-in");
        };
        // No observer, or motion turned down: show everything. The styles hide these blocks,
        // so something always has to bring them back.
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
          targets.forEach((el) => el.classList.add("is-shown"));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                io.unobserve(entry.target);
                show(entry.target as HTMLElement);
              }
            },
            // As soon as any part of a block is on screen: a block whose top edge already shows
            // at first paint must not sit there transparent until the visitor scrolls.
            { rootMargin: "0px", threshold: 0 },
          );
          targets.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>

<style>
  /* The trail floats over the top of the first section, so the hero's background runs up to
     the header. The first section reserves --crumbs-h for it (see global.css). */
  main {
    position: relative;
  }
  .has-crumbs {
    --crumbs-h: 2.6rem;
  }
  .crumbs-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding-top: 1.1rem;
  }
  main:focus {
    outline: none;
  }
</style>
