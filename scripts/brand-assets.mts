/**
 * Brand asset generator (`npm run brand`). Run by hand when the brand art changes; the
 * output is committed, so builds never depend on it.
 *
 * 1. Wordmark. Outlines "LUNA WOLF STUDIOS" from the Soup of Justice font into SVG path data
 *    and writes `src/lib/wordmark.ts`, which `Logo.astro` inlines with `fill: currentColor`.
 *    Outlines rather than a web font because the wordmark is a logo, not text: it stays
 *    crisp at any density, recolours per theme from CSS, costs no font request and cannot
 *    flash. It also keeps the font file itself out of this public repository. The license
 *    allows embedding but not redistributing the font, so the TTF is read from outside the
 *    repo: pass `--font <path>` or keep the default SplashKit location. Without the font the
 *    step is skipped and the committed wordmark is used as is.
 * 2. Favicons and the web manifest icons from `src/assets/logo/lws-emblem-512.png`.
 * 3. The default Open Graph card, `public/og-default.png` (1200x630).
 */
import { existsSync } from "node:fs";
import { readFile, writeFile, mkdir } from "node:fs/promises";
import path from "node:path";
import sharp from "sharp";
import { create, type Font } from "fontkitten";

const ROOT = process.cwd();
const PUBLIC_DIR = path.join(ROOT, "public");
const EMBLEM = path.join(ROOT, "src", "assets", "logo", "lws-emblem-512.png");
const EMBLEM_LARGE = path.join(ROOT, "archive", "wordpress", "media", "2025", "10", "LWS_2048x2048_transparent.png");
const WORDMARK_TS = path.join(ROOT, "src", "lib", "wordmark.ts");
const INTER = path.join(ROOT, "node_modules", "@fontsource-variable", "inter", "files", "inter-latin-wght-normal.woff2");

const NIGHT = "#04070a";
const TEAL = "#81ebe1";

const fontArg = process.argv.indexOf("--font");
const FONT_PATH =
  fontArg > -1 ? process.argv[fontArg + 1] : "S:/splashkit/assets/fonts/soup_of_justice/soupofjustice.ttf";

const r = (n: number) => Math.round(n * 10) / 10;

/** Lay a line of text out glyph by glyph and return one compound path in font units (y down). */
function outline(font: Font, text: string, tracking: number) {
  let x = 0;
  const parts: string[] = [];
  let minY = Infinity;
  let maxY = -Infinity;
  for (const glyph of font.glyphsForString(text)) {
    const cmds = glyph.path.commands;
    if (cmds.length) {
      const bb = glyph.bbox;
      minY = Math.min(minY, -bb.maxY);
      maxY = Math.max(maxY, -bb.minY);
      let d = "";
      for (const c of cmds) {
        // Flip y: fonts are y-up, SVG is y-down.
        const a = c.args.map((v, i) => (i % 2 === 0 ? Math.round(v + x) : Math.round(-v)));
        if (c.command === "moveTo") d += `M${a[0]} ${a[1]}`;
        else if (c.command === "lineTo") d += `L${a[0]} ${a[1]}`;
        else if (c.command === "quadraticCurveTo") d += `Q${a.join(" ")}`;
        else if (c.command === "bezierCurveTo") d += `C${a.join(" ")}`;
        else if (c.command === "closePath") d += "Z";
      }
      parts.push(d);
    }
    x += glyph.advanceWidth + tracking;
  }
  const width = x - tracking;
  return { d: parts.join(""), width, minY, maxY };
}

async function buildWordmark() {
  if (!existsSync(FONT_PATH)) {
    console.warn(`[brand] wordmark font not found at ${FONT_PATH}; keeping the committed src/lib/wordmark.ts`);
    return;
  }
  const font = create(await readFile(FONT_PATH)) as Font;
  // Tracking in font units. The splash sets the wordmark with a little air between letters.
  const tracking = font.unitsPerEm * 0.045;
  const line = outline(font, "LUNA WOLF STUDIOS", tracking);
  const stackedLines = ["LUNA", "WOLF", "STUDIOS"].map((t) => outline(font, t, tracking));

  // Normalise the single line to a tight box.
  const pad = 2;
  const single = {
    viewBox: `${-pad} ${r(line.minY - pad)} ${r(line.width + pad * 2)} ${r(line.maxY - line.minY + pad * 2)}`,
    width: r(line.width + pad * 2),
    height: r(line.maxY - line.minY + pad * 2),
    d: line.d,
  };

  // Stacked (three lines, left aligned like the splash) for the Open Graph card.
  const lineHeight = (line.maxY - line.minY) * 1.22;
  const stacked = stackedLines.map((l, i) => ({ ...l, dy: i * lineHeight }));
  const stackedD = stacked
    .map((l) =>
      l.d.replace(/(-?\d+(?:\.\d+)?) (-?\d+(?:\.\d+)?)/g, (_, px, py) => `${px} ${r(Number(py) + l.dy)}`),
    )
    .join("");
  const stackedW = Math.max(...stacked.map((l) => l.width));
  const stackedH = lineHeight * 2 + (line.maxY - line.minY);

  const ts = `/**
 * The "LUNA WOLF STUDIOS" wordmark as outlined SVG paths, set in Soup of Justice
 * (c) 2011 Omen Type. GENERATED by scripts/brand-assets.mts; do not edit by hand.
 *
 * The wordmark ships as outlines, not as a web font: the font license allows embedding
 * but not redistribution, and a logo should never reflow or flash. Logo.astro inlines
 * \`WORDMARK\` with fill="currentColor", so each theme colours it from CSS.
 */
export interface WordmarkPath {
  viewBox: string;
  width: number;
  height: number;
  d: string;
}

/** Single line, for the header and footer. */
export const WORDMARK: WordmarkPath = ${JSON.stringify(single, null, 2)};

/** Three lines (LUNA / WOLF / STUDIOS), left aligned, as on the splash screen. */
export const WORDMARK_STACKED: WordmarkPath = ${JSON.stringify(
    {
      viewBox: `${-pad} ${r(line.minY - pad)} ${r(stackedW + pad * 2)} ${r(stackedH + pad * 2)}`,
      width: r(stackedW + pad * 2),
      height: r(stackedH + pad * 2),
      d: stackedD,
    },
    null,
    2,
  )};
`;
  await writeFile(WORDMARK_TS, ts);
  console.log(`[brand] wordmark outlined → src/lib/wordmark.ts (${Math.round(ts.length / 1024)} KB)`);
}

/** A square icon: the emblem centred on a night disc, which keeps it legible on any tab colour. */
async function icon(size: number, { background = false, inset = 0 } = {}) {
  const inner = Math.round(size * (1 - inset * 2));
  const emblem = await sharp(EMBLEM)
    .resize(inner, inner, { kernel: "lanczos3" })
    .sharpen(size <= 32 ? { sigma: 0.6 } : undefined)
    .png()
    .toBuffer();
  const base = sharp({
    create: {
      width: size,
      height: size,
      channels: 4,
      background: background ? NIGHT : { r: 0, g: 0, b: 0, alpha: 0 },
    },
  });
  const off = Math.round((size - inner) / 2);
  return base.composite([{ input: emblem, left: off, top: off }]).png({ compressionLevel: 9 }).toBuffer();
}

/** Minimal .ico writer holding PNG entries (supported by every current browser). */
function ico(pngs: Array<{ size: number; data: Buffer }>): Buffer {
  const header = Buffer.alloc(6);
  header.writeUInt16LE(0, 0);
  header.writeUInt16LE(1, 2);
  header.writeUInt16LE(pngs.length, 4);
  const dir = Buffer.alloc(16 * pngs.length);
  let offset = 6 + dir.length;
  pngs.forEach(({ size, data }, i) => {
    const o = i * 16;
    dir.writeUInt8(size >= 256 ? 0 : size, o);
    dir.writeUInt8(size >= 256 ? 0 : size, o + 1);
    dir.writeUInt16LE(1, o + 4); // colour planes
    dir.writeUInt16LE(32, o + 6); // bits per pixel
    dir.writeUInt32LE(data.length, o + 8);
    dir.writeUInt32LE(offset, o + 12);
    offset += data.length;
  });
  return Buffer.concat([header, dir, ...pngs.map((p) => p.data)]);
}

async function buildIcons() {
  await mkdir(PUBLIC_DIR, { recursive: true });
  const out: Array<[string, Buffer]> = [
    ["favicon-16.png", await icon(16)],
    ["favicon-32.png", await icon(32)],
    // iOS paints transparency black and rounds the corners itself, so give it the night sky.
    ["apple-touch-icon.png", await icon(180, { background: true, inset: 0.08 })],
    ["icon-192.png", await icon(192)],
    ["icon-512.png", await icon(512)],
    // Maskable icons get cropped to a circle or squircle: keep the emblem inside the safe zone.
    ["icon-maskable-512.png", await icon(512, { background: true, inset: 0.12 })],
  ];
  for (const [file, data] of out) await writeFile(path.join(PUBLIC_DIR, file), data);
  await writeFile(
    path.join(PUBLIC_DIR, "favicon.ico"),
    ico([
      { size: 16, data: await icon(16) },
      { size: 32, data: await icon(32) },
      { size: 48, data: await icon(48) },
    ]),
  );
  const manifest = {
    name: "Luna Wolf Studios",
    short_name: "Luna Wolf",
    description: "Game and software development studio in Newark, Delaware.",
    start_url: "/",
    display: "browser",
    background_color: NIGHT,
    theme_color: NIGHT,
    icons: [
      { src: "/icon-192.png", sizes: "192x192", type: "image/png" },
      { src: "/icon-512.png", sizes: "512x512", type: "image/png" },
      { src: "/icon-maskable-512.png", sizes: "512x512", type: "image/png", purpose: "maskable" },
    ],
  };
  await writeFile(path.join(PUBLIC_DIR, "site.webmanifest"), JSON.stringify(manifest, null, 2) + "\n");
  console.log(`[brand] favicons, touch icon, manifest icons and site.webmanifest → public/`);
}

/** Seeded PRNG so the star field is identical on every run (no churn in git). */
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

async function buildOg() {
  const W = 1200;
  const H = 630;
  const { WORDMARK_STACKED } = await import(`file://${WORDMARK_TS.replace(/\\/g, "/")}?t=${Date.now()}`);

  // Tagline set in Inter, outlined too, so the card renders the same on any machine.
  const inter = create(await readFile(INTER)) as Font;
  const tag = outline(inter, "Game and software development studio", 0);

  const rand = mulberry32(2015);
  const stars = Array.from({ length: 120 }, () => {
    const x = rand() * W;
    const y = rand() * H;
    const s = rand();
    return `<circle cx="${r(x)}" cy="${r(y)}" r="${r(0.5 + s * 1.3)}" fill="#e8fbff" opacity="${r(0.15 + s * 0.55)}"/>`;
  }).join("");

  const emblemSize = 430;
  const ex = 96;
  const ey = (H - emblemSize) / 2;
  const cx = ex + emblemSize / 2;
  const cy = H / 2;

  const wmW = 520;
  const wmScale = wmW / WORDMARK_STACKED.width;
  const wmH = WORDMARK_STACKED.height * wmScale;
  const wmX = 590;
  const wmY = 128;
  const [vbX, vbY] = WORDMARK_STACKED.viewBox.split(" ").map(Number);

  const tagSize = 30; // px
  const tagScale = tagSize / inter.unitsPerEm;
  const tagY = wmY + wmH + 50;

  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">
  <defs>
    <radialGradient id="sky" cx="${cx / W}" cy="0.5" r="0.95">
      <stop offset="0" stop-color="#10232b"/>
      <stop offset="0.45" stop-color="#08131a"/>
      <stop offset="1" stop-color="${NIGHT}"/>
    </radialGradient>
    <radialGradient id="glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0.55" stop-color="#9fe6ea" stop-opacity="0.38"/>
      <stop offset="0.75" stop-color="#5fb3bb" stop-opacity="0.12"/>
      <stop offset="1" stop-color="#5fb3bb" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="${W}" height="${H}" fill="url(#sky)"/>
  ${stars}
  <circle cx="${cx}" cy="${cy}" r="${emblemSize * 0.72}" fill="url(#glow)"/>
  <g transform="translate(${wmX} ${wmY}) scale(${r(wmScale * 1000) / 1000}) translate(${-vbX} ${-vbY})">
    <path d="${WORDMARK_STACKED.d}" fill="${TEAL}"/>
  </g>
  <g transform="translate(${wmX + 4} ${r(tagY)}) scale(${tagScale})">
    <path d="${tag.d}" fill="#cfe3e6"/>
  </g>
</svg>`;

  const emblem = await sharp(existsSync(EMBLEM_LARGE) ? EMBLEM_LARGE : EMBLEM)
    .resize(emblemSize, emblemSize, { kernel: "lanczos3" })
    .png()
    .toBuffer();
  const png = await sharp(Buffer.from(svg))
    .composite([{ input: emblem, left: ex, top: Math.round(ey) }])
    .png({ compressionLevel: 9, palette: false })
    .toBuffer();
  await writeFile(path.join(PUBLIC_DIR, "og-default.png"), png);
  console.log(`[brand] og-default.png — ${W}x${H}, ${Math.round(png.length / 1024)} KB`);
}

await buildWordmark();
await buildIcons();
await buildOg();
console.log("[brand] done.");
