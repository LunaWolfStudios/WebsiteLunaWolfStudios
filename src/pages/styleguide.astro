---
/**
 * /styleguide/ — every shared component and helper with realistic content (copy taken from
 * archive/wordpress/pages/). noindex and left out of the sitemap. Open it with ?theme=light
 * or ?theme=dark to check both themes.
 *
 * QA hooks (this page only): ?open=video plays the first video in the theater, ?open=lightbox
 * opens the gallery viewer, ?open=menu opens the mobile menu, ?open=services focuses the
 * Services dropdown, ?formtest=ok|fail submits the contact and newsletter forms against a
 * stubbed fetch (nothing leaves the browser).
 *
 * ─── How to build a page ─────────────────────────────────────────────────────────────────
 *
 *   ---
 *   import BaseLayout from "../../layouts/BaseLayout.astro";
 *   import PageHero from "../../components/PageHero.astro";
 *   import Section from "../../components/Section.astro";
 *   import ServiceCard from "../../components/ServiceCard.astro";
 *   import GameCard from "../../components/GameCard.astro";
 *   import Faq from "../../components/Faq.astro";
 *   import CtaBand from "../../components/CtaBand.astro";
 *   import { serviceLd, faqLd } from "../../lib/seo";
 *   import { GAMES } from "../../data/games";
 *
 *   const title = "Unity development";                       // " | Luna Wolf Studios" is added
 *   const description = "140 to 160 characters that say what the page offers, in search words.";
 *   const faqs = [{ q: "...", a: "..." }];
 *   ---
 *   <BaseLayout
 *     title={title}
 *     description={description}
 *     breadcrumbs={[{ label: "Services", href: "/services/" }, { label: title, href: "/services/unity-development/" }]}
 *     jsonLd={[serviceLd({ name: title, description, url: "/services/unity-development/" }), faqLd(faqs)]}
 *   >
 *     <PageHero eyebrow="Services" title="Unity development studio" lead="One or two sentences.">
 *       <Fragment slot="actions">
 *         <a class="btn btn--primary" href="/contact/">Start a project</a>
 *         <a class="btn btn--secondary" href="/games/">See our work</a>
 *       </Fragment>
 *     </PageHero>
 *     <Section eyebrow="What we do" title="..." lead="...">          (tone alternates: default, raised)
 *       <div class="grid grid--3">...</div>
 *     </Section>
 *     <Section tone="raised" title="Projects that prove it">
 *       <div class="grid grid--4">{GAMES.filter(...).map((g) => <GameCard game={g} />)}</div>
 *     </Section>
 *     <Section title="Questions" width="narrow"><Faq items={faqs} /></Section>
 *     <CtaBand />
 *   </BaseLayout>
 *
 * Rules: one <h1> per page (PageHero renders it). Internal links end in "/". External URLs
 * come from src/data/links.ts. Images go through astro:assets with real alt text.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
