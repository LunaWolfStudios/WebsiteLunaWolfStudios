---
/**
 * /decks/ (unlisted): the six pitch decks, each a card with its lead project art, title, lead,
 * slide count, and links to the deck page (/decks/<slug>/) and its PDF. The decks themselves
 * are standalone files in public/decks/, generated by scripts/decks/build.mts.
 *
 * Unlisted: noindex, left out of the sitemap (astro.config.mjs UNLISTED), and linked from no
 * other page, menu, header, or footer. Everything shown comes from src/data/decks.ts, the
 * record the generator also reads.
 */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { DECKS, deckPdf, deckUrl } from "../../data/decks";
import { image } from "../../lib/images";

const title = "Pitch decks";
const description =
  "Short pitch decks from Luna Wolf Studios on health games, serious games, playable ads, mobile games, VR and AR, and Unity development, to view or download.";
---

<BaseLayout title={title} description={description} noindex>
  <PageHero
    eyebrow="Luna Wolf Studios"
    title="Pitch decks"
    size="compact"
  />

  <Section tight>
    <ul class="deck-grid" role="list">
      {
        DECKS.map((d, i) => (
          <li class="card deck-card" data-reveal>
            <a class="dc-art" href={deckUrl(d.slug)} tabindex="-1" aria-hidden="true">
              <Image
                src={image(d.image)}
                alt=""
                width={640}
                height={360}
                widths={[400, 640, 960]}
                sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 380px"
                loading={i < 3 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
              />
            </a>
            <div class="dc-body">
              <span class="badge badge--neutral">{d.slides} slides</span>
              <h2 class="dc-title">{d.title}</h2>
              <p class="dc-lead">{d.lead}</p>
              <div class="dc-actions">
                <a class="btn btn--primary btn--sm" href={deckUrl(d.slug)}>
                  <span>View<span class="visually-hidden"> the {d.label}</span> deck</span> <Icon name="arrowRight" size={16} />
                </a>
                <a class="btn btn--secondary btn--sm" href={deckPdf(d.slug)} download>
                  <Icon name="download" size={16} /><span><span class="visually-hidden">Download the {d.label} deck as a </span>PDF</span>
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  .deck-grid {
    display: grid;
    gap: clamp(1rem, 2.2vw, 1.5rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }
  @media (max-width: 1000px) {
    .deck-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .deck-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .deck-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .dc-art {
    display: block;
    background: var(--lw-media-bg);
  }
  .dc-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .dc-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    flex: 1;
    padding: clamp(1.1rem, 2vw, 1.4rem);
  }
  .dc-title {
    font-size: var(--lw-h3);
    margin: 0;
  }
  .dc-lead {
    margin: 0;
    color: var(--lw-ink-muted);
    line-height: 1.55;
  }
  .dc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }
</style>
