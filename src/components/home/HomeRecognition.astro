---
/**
 * The studio's recognition as a compact strip, worded exactly as src/data/awards.ts words it
 * (the Unity Awards nominations lead; founders' personal awards are left out). AwardBadge
 * shows the awarding body and the title; the subject goes on the year line, so a jam win
 * never reads as the studio's.
 *
 * All three Unity Awards nominations are here: the studio's two, then the one for Lanebreak,
 * a game we worked on for Peloton. The award is the owner's, so its year line names the owner
 * ("Lanebreak, by Peloton").
 */
import Section from "../Section.astro";
import AwardBadge from "../AwardBadge.astro";
import { ALL_AWARDS, STUDIO_AWARDS } from "../../data/awards";
import type { Award } from "../../data/types";

const isUnity = (a: Award) => /Unity Awards$/.test(a.body);
// Two groups, so the Unity Awards nominations hold the first row and the rest wrap evenly.
const groups = [
  [...STUDIO_AWARDS.filter(isUnity), ...ALL_AWARDS.filter((a) => isUnity(a) && a.owner)],
  STUDIO_AWARDS.filter((a) => !isUnity(a)),
];
---

<Section id="recognition" tone="sky" align="center" tight eyebrow="Recognition" title="Awards and recognition">
  <div class="award-groups">
    {
      groups.map((group, g) => (
        <ul class:list={["awards", { "awards--rest": g > 0 }]} role="list">
          {group.map((a, i) => (
            <li data-reveal="fade" style={`--reveal-delay:${Math.min(i + g * 3, 6) * 60}ms`}>
              <AwardBadge
                label={a.body}
                title={a.title}
                year={`${a.owner ? `${a.subject}, by ${a.owner}` : a.subject} · ${a.year}`}
                href={a.url}
                size="sm"
                tone={isUnity(a) ? "gold" : "accent"}
              />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</Section>

<style>
  .award-groups {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
  }
  /* Narrow enough that five badges sit three over two, never four over one. */
  .awards--rest {
    max-width: 960px;
  }
  .awards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
  }
  .awards > li {
    display: flex;
    justify-content: center;
    min-width: 0;
  }
</style>
