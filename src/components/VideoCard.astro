---
/**
 * A YouTube video as a poster card. Clicking plays it in the shared Theater dialog (mounted
 * by BaseLayout); without JavaScript it is a plain link to YouTube. The page requests nothing
 * from YouTube until someone presses play, and the poster is our own image.
 *
 *   <VideoCard id="GiCsebs_FK4" title="Hypno Halo trailer" poster="games/hypno-halo/trailer.jpg" />
 *   <VideoCard video={item} />                       a VideoItem from src/data/types.ts
 *   <VideoCard ... variant="feature" eager />        large, title over the poster (hero media)
 *
 * `poster` is an imported image or a file name resolved by src/lib/images.ts. Without a
 * poster the card shows a night-sky panel; it still plays.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import type { VideoItem } from "../data/types";
import { image } from "../lib/images";

interface Props {
  video?: VideoItem;
  id?: string;
  title?: string;
  poster?: ImageMetadata | string;
  /** A second video id that plays when this one ends. */
  next?: string;
  /** Small line under the title (length, date). */
  meta?: string;
  variant?: "card" | "feature";
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const p = Astro.props;
const id = p.id ?? p.video?.id ?? "";
const title = p.title ?? p.video?.title ?? "Video";
const posterRef = p.poster ?? p.video?.poster;
const poster = typeof posterRef === "string" ? image(posterRef) : posterRef;
const variant = p.variant ?? "card";
const sizes =
  p.sizes ??
  (variant === "feature"
    ? "(max-width: 900px) 100vw, 600px"
    : "(max-width: 560px) 100vw, (max-width: 1000px) 50vw, 380px");
---

<a
  class:list={["video-card", `video-card--${variant}`, p.class]}
  href={`https://www.youtube.com/watch?v=${id}`}
  data-video-id={id}
  data-video-next={p.next}
  data-video-title={title}
  target="_blank"
  rel="noopener"
>
  <span class="vc-poster">
    {
      poster ? (
        <Image
          src={poster}
          alt=""
          widths={variant === "feature" ? [640, 720, 960, 1280] : [400, 640, 800]}
          sizes={sizes}
          loading={p.eager ? "eager" : "lazy"}
          fetchpriority={p.eager ? "high" : undefined}
          decoding="async"
          class="vc-img"
        />
      ) : (
        <span class="vc-empty sky" />
      )
    }
    <span class="vc-play" aria-hidden="true"><Icon name="play" size={variant === "feature" ? 30 : 24} /></span>
    {
      /* The link's name is its visible text with "Play video:" in front (hidden), so what
         a speech user reads off the card is what the link is called. */
      variant === "feature" && (
        <span class="vc-overlay-title">
          <span class="visually-hidden">Play video: </span>
          {title}
        </span>
      )
    }
  </span>
  {
    variant === "card" && (
      <span class="vc-text">
        <span class="vc-title">
          <span class="visually-hidden">Play video: </span>
          {title}
        </span>
        {p.meta && <span class="vc-meta">{p.meta}</span>}
      </span>
    )
  }
</a>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--lw-radius-lg);
    overflow: hidden;
    background: var(--lw-surface);
    border: 1px solid var(--lw-border);
    box-shadow: var(--lw-shadow);
    color: var(--lw-ink);
    text-decoration: none;
    transition: transform 0.2s var(--lw-ease), border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .video-card:hover,
  .video-card:focus-visible {
    color: var(--lw-ink);
    transform: translateY(-3px);
    border-color: var(--lw-accent-line);
    box-shadow: var(--lw-shadow-hover);
  }
  .vc-poster {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: #070d12;
    overflow: hidden;
  }
  .vc-img,
  .vc-empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--lw-ease);
  }
  .vc-empty {
    background: radial-gradient(50% 60% at 50% 40%, rgba(129, 235, 225, 0.18), transparent 70%), #070d12;
  }
  .video-card:hover .vc-img {
    transform: scale(1.03);
  }
  /* Always on a dark poster, so fixed light-on-dark colours in both themes. The button sits
     in the bottom-right corner: most posters carry their own title across the middle, and a
     centred button would cover it. */
  .vc-play {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding-left: 3px;
    border-radius: 50%;
    border: 1px solid rgba(238, 247, 247, 0.32);
    background: rgba(4, 7, 10, 0.74);
    color: #eef7f7;
    box-shadow: 0 0 0 0 rgba(129, 235, 225, 0.4);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s var(--lw-ease), box-shadow 0.3s ease;
  }
  .video-card--feature .vc-play {
    right: 1rem;
    bottom: 1rem;
    width: 64px;
    height: 64px;
  }
  .video-card:hover .vc-play,
  .video-card:focus-visible .vc-play {
    background: #81ebe1;
    color: #04070a;
    transform: scale(1.08);
    box-shadow: 0 0 0 8px rgba(129, 235, 225, 0.16);
  }
  .vc-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem 1rem;
  }
  .vc-title {
    font-family: var(--lw-font-display);
    font-weight: 600;
    line-height: 1.3;
  }
  .vc-meta {
    font-size: var(--lw-text-sm);
    color: var(--lw-ink-subtle);
  }
  .video-card--feature {
    box-shadow: var(--lw-shadow-lg);
  }
  .vc-overlay-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* Right padding keeps the title clear of the play button in the corner. */
    padding: 2.5rem 5.75rem 0.9rem 1.1rem;
    background: linear-gradient(to top, rgba(4, 7, 10, 0.85), transparent);
    color: #eef7f7;
    font-family: var(--lw-font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-card:hover,
    .video-card:focus-visible,
    .video-card:hover .vc-img,
    .video-card:hover .vc-play,
    .video-card:focus-visible .vc-play {
      transform: none;
    }
  }
</style>
