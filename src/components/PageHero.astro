---
/**
 * The top of an inner page: eyebrow, the page's one <h1>, a lead, actions, and optional
 * media on the right (below on phones).
 *
 *   <PageHero eyebrow="Services" title="Unity development" lead="We build and ship Unity games and tools.">
 *     <Fragment slot="actions">
 *       <a class="btn btn--primary" href="/contact/">Start a project</a>
 *       <a class="btn btn--secondary" href="/games/">See our work</a>
 *     </Fragment>
 *     <Image slot="media" src={cover} alt="..." loading="eager" fetchpriority="high" />
 *   </PageHero>
 *
 * Media can be any image, a VideoCard, or a StoreButton row. Images in the media slot are
 * the largest thing above the fold: give them loading="eager" and fetchpriority="high".
 * `size="compact"` trims the padding for utility pages (contact, privacy).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  size?: "default" | "compact";
  align?: "start" | "center";
  class?: string;
}

const { eyebrow, title, lead, size = "default", align = "start", class: cls } = Astro.props;
const hasMedia = Astro.slots.has("media");
const hasActions = Astro.slots.has("actions");
---

<section
  class:list={["page-hero", "sky", `page-hero--${size}`, `page-hero--${align}`, { "has-media": hasMedia }, cls]}
>
  <div class="wrap ph-inner">
    <div class="ph-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="ph-title">{title}</h1>
      {lead && <p class="lead ph-lead">{lead}</p>}
      <slot />
      {
        hasActions && (
          <div class="ph-actions">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      hasMedia && (
        <div class="ph-media">
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    /* --crumbs-h: room for the breadcrumb trail BaseLayout floats over the first section. */
    padding-block: calc(var(--crumbs-h, 0px) + clamp(2.25rem, 5vw, 4.5rem)) clamp(3rem, 7vw, 6rem);
    background:
      radial-gradient(55% 75% at 82% 10%, var(--lw-glow), transparent 70%),
      radial-gradient(40% 60% at 8% 0%, color-mix(in srgb, var(--lw-glow) 60%, transparent), transparent 70%),
      var(--lw-bg);
    border-bottom: 1px solid color-mix(in srgb, var(--lw-border) 60%, transparent);
  }
  .page-hero--compact {
    padding-block: calc(var(--crumbs-h, 0px) + clamp(1.75rem, 3.5vw, 2.75rem)) clamp(2rem, 4.5vw, 3.5rem);
  }
  .ph-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .has-media .ph-inner {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    /* Top-aligned: when the heading font arrives and the text column changes height, a
       centred picture would move with it (a layout shift). */
    align-items: start;
  }
  .ph-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 720px;
  }
  .page-hero--center .ph-text {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .page-hero--center .ph-lead {
    margin-inline: auto;
  }
  .ph-title {
    margin: 0;
  }
  .page-hero--compact .ph-title {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.1rem);
  }
  .ph-lead {
    font-size: var(--lw-text-xl);
  }
  /* A short laptop screen (1280x720, 1366x768): tighten the hero so the first button is on
     the first screen even under a four-line title. */
  @media (min-width: 901px) and (max-height: 800px) {
    .page-hero {
      padding-block: calc(var(--crumbs-h, 0px) + 1.5rem) 2.75rem;
    }
    .ph-title {
      font-size: clamp(2.25rem, 1.4rem + 2.2vw, 3.2rem);
    }
    .ph-text {
      gap: 0.85rem;
    }
  }
  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .ph-media {
    position: relative;
    min-width: 0;
  }
  .ph-media > :global(img),
  .ph-media > :global(picture img) {
    width: 100%;
    height: auto;
    border-radius: var(--lw-radius-lg);
    border: 1px solid var(--lw-border);
    box-shadow: var(--lw-shadow-lg);
  }
  @media (max-width: 900px) {
    .has-media .ph-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
