---
/**
 * /about/: the studio page. Carries the old About page in full (archive/wordpress/pages/about.md:
 * "Our Origin", the 2015 East Coast Reboot photo, "Our Founders" and the founder links) and
 * adds recent event photos, the timeline, recognition, the partner wall, and what we do. The
 * animated logo plays beside the title; the 2015 photo sits at its year in the timeline.
 *
 * It carries the local signal (Newark, Delaware; Wilmington University; January 2015).
 * Founders are named as the old site names them: Jeff, Jeremy Bregermann, Olivia.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import FounderCard from "../components/FounderCard.astro";
import AwardBadge from "../components/AwardBadge.astro";
import PartnerCloud from "../components/PartnerCloud.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import Gallery from "../components/Gallery.astro";
import Timeline from "../components/about/Timeline.astro";
import SplashPlayer from "../components/about/SplashPlayer.astro";
import { FOUNDERS } from "../data/team";
import { work } from "../data/games";
import { ALL_AWARDS, STUDIO_AWARDS } from "../data/awards";
import { PARTNERS } from "../data/partners";
import { INTERNSHIP } from "../data/timeline";
import { EVENT_LAYOUT, EVENT_PHOTOS } from "../data/photos";
import { SITE } from "../data/site";
import { ORG_ID, abs } from "../lib/seo";
import { image } from "../lib/images";
import splashPoster from "../assets/hero/splash-poster.png";

const title = "About Luna Wolf Studios, a Delaware game studio";
const description =
  "Luna Wolf Studios is an independent game and software studio in Newark, Delaware, founded in 2015 by three Wilmington University students. Meet the pack.";

// Scriptable Sheets and the studio at the 17th, and Lanebreak, by Peloton, at the 16th.
const unityNominations = ALL_AWARDS.filter((a) => /Unity Awards$/.test(a.body)).length;

const jsonLd = [
  {
    "@type": "AboutPage",
    "@id": `${abs("/about/")}#webpage`,
    url: abs("/about/"),
    name: title,
    description,
    inLanguage: "en-US",
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": ORG_ID },
    mainEntity: { "@id": ORG_ID },
  },
];

// Share image: the studio's splash (2560x1440), large enough for a wide link preview.
const SHARE_ALT =
  "The Luna Wolf Studios logo: a wolf's head in front of a teal full moon in a starry night sky, beside the teal wordmark";

const WHAT_WE_DO = [
  {
    icon: "briefcase",
    title: "Services",
    text: "Games, Unity development and editor tools, VR and AR, serious games, and custom software, built for clients.",
    href: "/services/",
    cta: "See our services",
    art: work("helix").wide!,
  },
  {
    icon: "gamepad",
    title: "Games",
    text: "Our own games, the games we publish, and the games we've worked on with partners.",
    href: "/games/",
    cta: "Browse the games",
    art: work("hypno-halo").wide!,
  },
  {
    icon: "graduationCap",
    title: "Internships and bootcamp",
    text: "A remote internship program whose teams ship real games, and an introductory game development bootcamp.",
    href: "/bootcamp/",
    cta: "See internships and bootcamp",
    art: work("on-the-rocks").wide!,
  },
];
---

<BaseLayout title={title} description={description} breadcrumbs={[{ label: "About", href: "/about/" }]} jsonLd={jsonLd} image={splashPoster} imageAlt={SHARE_ALT}>
  <PageHero
    eyebrow="Our studio"
    title="About Luna Wolf Studios"
    lead="An independent game and software studio in Newark, Delaware. We make our own games and Unity tools, build games and software for clients, publish other developers' games, and train new developers."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="/contact/">Start a project <Icon name="arrowRight" size={18} /></a>
      <a class="btn btn--secondary" href="#founders">Meet the founders</a>
    </Fragment>
    <SplashPlayer slot="media" eager />
  </PageHero>

  <Section id="origin" title="Our origin">
    <div class="origin">
      <div class="origin-text" data-reveal>
        <p>
          Three Wilmington University students founded Luna Wolf Studios in January 2015, in Newark, Delaware. That year
          our game Fungeon Crawler took 1st place at the university's East Coast Reboot game jam.
        </p>
        <p>
          Since then we have shipped <a href="/hypno-halo/">Hypno Halo</a> and <a href="/paralily/">ParaLily</a> on Steam
          and Nintendo Switch, put <a href="/scriptable-sheets/">Scriptable Sheets</a> on the Unity Asset Store, and are
          taking <a href="/sheep-tag-2/">Sheep Tag 2</a> to Early Access in 2027. We have worked on games and software with
          Peloton, Cartoon Network, Barron Associates, Legends of Learning, and Nemours Children's Health. We work in Unity,
          Unreal, Godot, and more.
        </p>
        <p>
          We publish other developers' games, such as{" "}
          <a href="/the-brave-hearts-ii-false-skies/">The Brave Hearts II: False Skies</a>, and we teach: our interns ship
          games, and co-founder Jeremy is a game design professor at the University of Illinois
          Urbana-Champaign and Wilmington University and a graduate instructor at West Virginia University.
        </p>
      </div>
      <div class="stat-row origin-stats" data-reveal>
        <Stat value="2015" label="Founded in Newark, Delaware" />
        <Stat value={unityNominations} label="Unity Awards nominations" note="Two at the 17th, and Lanebreak by Peloton at the 16th" tone="gold" />
        <Stat value={INTERNSHIP.cohorts.length} label="Intern teams, each shipped a game" note="Since summer 2025" />
        <Stat value={PARTNERS.length} label="Partners and schools we have worked with" note="Our Trusted Pack" tone="ink" />
      </div>
    </div>
  </Section>

  <Section
    id="founders"
    title="The founders"
    lead="Three co-founders, three specialties: Unity and XR engineering, game design and teaching, and enterprise backends."
    tone="raised"
  >
    <ul class="founders" role="list">
      {
        FOUNDERS.map((f) => (
          <li data-reveal>
            <FounderCard founder={f} />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="events" title="The pack on the road" lead="ImmerseCon, Thy Geekdom Con, Awesome Con, and PAX East.">
    <Gallery
      id="event-photos"
      images={EVENT_PHOTOS.map((p) => ({ src: p.image, alt: p.alt, caption: p.caption }))}
      rows={EVENT_LAYOUT.rows}
      rowsSm={EVENT_LAYOUT.rowsSm}
      label="Event photos"
    />
  </Section>

  <Section id="story" title="The story so far" lead="From a game jam win in 2015 to games on Steam and Nintendo Switch." tone="raised">
    <Timeline />
  </Section>

  <Section id="recognition" title="Awards and recognition">
    <ul class="awards" role="list">
      {
        STUDIO_AWARDS.map((a, i) => (
          <li class="award-card card" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 40}ms`}>
            <AwardBadge award={a} />
            <p class="award-subject">{a.subject}</p>
          </li>
        ))
      }
    </ul>
    <p class="awards-more">
      Logos, screenshots, and fact sheets for press are in the <a href="/presskit/">press kit</a>.
    </p>
  </Section>

  <Section
    id="partners"
    title="Our Trusted Pack"
    lead="The companies, schools, and organizations we have worked with."
    align="center"
    tone="raised"
  >
    <PartnerCloud partners={PARTNERS} />
  </Section>

  <Section id="what-we-do" title="What we do">
    <ul class="wwd" role="list">
      {
        WHAT_WE_DO.map((c) => (
          <li data-reveal>
            <a class="wwd-card card card--link" href={c.href}>
              <Image
                src={image(c.art)}
                alt=""
                widths={[400, 640, 800]}
                sizes="(max-width: 860px) calc(100vw - 32px), 380px"
                loading="lazy"
                decoding="async"
                class="wwd-img"
              />
              <span class="wwd-title">
                <span class="wwd-icon" aria-hidden="true">
                  <Icon name={c.icon} size={20} />
                </span>
                {c.title}
              </span>
              <span class="wwd-text">{c.text}</span>
              <span class="wwd-cta">
                {c.cta} <Icon name="arrowRight" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="wwd-more">
      Have a game to release? See <a href="/publishing/">publishing with Luna Wolf Studios</a>.
    </p>
  </Section>

  <CtaBand />
</BaseLayout>

<style>
  .origin {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .origin-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 66ch;
  }
  .origin-text p {
    font-size: var(--lw-text-lg);
    line-height: 1.7;
    color: var(--lw-ink-muted);
  }
  .origin-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 1.75rem 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--lw-radius-lg);
    border: 1px solid var(--lw-border);
    background: var(--lw-surface);
  }
  .origin-stats > :global(.stat + .stat) {
    padding-left: 0 !important;
    border-left: 0 !important;
  }

  .founders {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
    margin: 0;
    padding: 0;
  }

  /* Rows of four, the last row centered. */
  .awards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  .awards > li {
    flex: 0 0 calc((100% - 3rem) / 4);
  }
  @media (max-width: 1000px) {
    .awards > li {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }
  @media (max-width: 480px) {
    .awards > li {
      flex-basis: 100%;
    }
  }
  .award-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.25rem 0.75rem 1rem;
    text-align: center;
  }
  .award-subject {
    font-size: var(--lw-text-sm);
    color: var(--lw-ink-muted);
  }
  .awards-more {
    margin-top: 1.5rem;
    color: var(--lw-ink-muted);
  }

  .wwd {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
    margin: 0;
    padding: 0;
  }
  .wwd-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    overflow: hidden;
    padding: 0 clamp(1.35rem, 2.4vw, 1.75rem) clamp(1.35rem, 2.4vw, 1.75rem);
    color: var(--lw-ink);
    text-decoration: none;
  }
  .wwd-img {
    display: block;
    width: calc(100% + 2 * clamp(1.35rem, 2.4vw, 1.75rem));
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    margin: 0 calc(-1 * clamp(1.35rem, 2.4vw, 1.75rem)) 0.4rem;
    object-fit: cover;
    border-bottom: 1px solid var(--lw-border);
    background: var(--lw-media-bg);
  }
  .wwd-icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--lw-radius);
    background: var(--lw-accent-tint);
    border: 1px solid var(--lw-accent-line);
    color: var(--lw-accent);
  }
  .wwd-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--lw-font-display);
    font-weight: 650;
    font-size: 1.3rem;
  }
  .wwd-text {
    color: var(--lw-ink-muted);
    line-height: 1.6;
  }
  .wwd-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--lw-font-display);
    font-weight: 600;
    color: var(--lw-accent);
  }
  .wwd-more {
    margin-top: 1.5rem;
    color: var(--lw-ink-muted);
  }

  @media (max-width: 1000px) {
    .founders {
      grid-template-columns: minmax(0, 1fr);
    }
    .origin {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* One column on tablets: photo beside the text, as FounderCard's row layout does. */
  @media (min-width: 561px) and (max-width: 1000px) {
    .founders :global(.founder) {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
  @media (max-width: 860px) {
    .wwd {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .origin-stats {
      grid-template-columns: minmax(0, 1fr) !important;
    }
  }
</style>
