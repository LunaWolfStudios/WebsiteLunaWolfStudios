---

<BaseLayout
  title="Styleguide"
  description="Internal reference for the Luna Wolf Studios website: design tokens, type, buttons, cards and every shared component in both themes."
  noindex
  breadcrumbs={[{ label: "Styleguide", href: "/styleguide/" }]}
>
  <PageHero
    eyebrow="Design system"
    title="Styleguide"
    lead="Every shared component and helper, with real copy from the old site. Toggle the theme in the header to check both."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#components">Components <Icon name="arrowRight" size={18} /></a>
      <a class="btn btn--secondary" href="?theme=light">Light theme</a>
      <a class="btn btn--ghost" href="?theme=dark">Dark theme</a>
    </Fragment>
    <div slot="media" class="sg-hero-media">
      <VideoCard id="GiCsebs_FK4" title="Hypno Halo trailer" poster={hypnoPoster} variant="feature" eager />
    </div>
  </PageHero>

  <Section id="tokens" eyebrow="Foundations" title="Colour" lead="Tokens from src/styles/tokens.css, as the current theme resolves them.">
    <ul class="swatches" role="list">
      {
        swatches.map(([v, name]) => (
          <li class="swatch">
            <span class="swatch-chip" style={`background: var(${v})`} />
            <span class="swatch-name">{name}</span>
            <code class="swatch-var">{v}</code>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="type" tone="raised" eyebrow="Foundations" title="Type">
    <div class="type-demo stack" style="--stack-gap: 1.25rem">
      <p class="eyebrow">Eyebrow · Outfit 600, tracked</p>
      <p class="sg-display">Display: create experiences that matter</p>
      <p class="sg-h1">Heading 1: Game development studio</p>
      <h2>Heading 2: Our trusted pack</h2>
      <h3>Heading 3: Remote internship program</h3>
      <h4>Heading 4: HELIX components</h4>
      <p class="lead">
        Lead: We are an independent video game development studio with a dedicated pack focused on creating
        experiences that matter.
      </p>
      <p class="measure">
        Body, Inter: Founded by three Wilmington University students in January of 2015, Luna Wolf Studios is an
        independent video game development studio that was born in Newark, Delaware. <a href="/about/">Inline link</a>,{" "}
        <strong>strong text</strong>, <code>inline code</code>.
      </p>
      <p class="text-muted">Muted: secondary information and captions.</p>
      <p class="text-subtle">Subtle: metadata, timestamps, fine print.</p>
    </div>
  </Section>

  <Section id="components" eyebrow="Actions" title="Buttons, badges and links">
    <div class="stack" style="--stack-gap: 1.5rem">
      <div class="cluster">
        <a class="btn btn--primary" href="/contact/">Contact us</a>
        <a class="btn btn--secondary" href="/games/">See our games</a>
        <a class="btn btn--ghost" href="/about/">About the studio</a>
        <button class="btn btn--primary" disabled>Disabled</button>
      </div>
      <div class="cluster">
        <a class="btn btn--primary btn--lg" href="/contact/">Start a project <Icon name="arrowRight" size={18} /></a>
        <a class="btn btn--secondary btn--lg" href="#videos"><Icon name="play" size={18} /> Watch the trailer</a>
        <a class="btn btn--primary btn--sm" href="/contact/">Small</a>
        <a class="btn btn--secondary btn--sm" href="/presskit/"><Icon name="download" size={16} /> Press kit</a>
      </div>
      <div class="cluster">
        <span class="badge">Unity</span>
        <span class="badge badge--gold"><Icon name="star" size={12} /> Award winner</span>
        <span class="badge badge--rose">New</span>
        <span class="badge badge--neutral">Archived</span>
        <span class="badge badge--solid">Out now</span>
      </div>
      <div class="cluster">
        <a class="link-arrow" href="/services/">All services <Icon name="arrowRight" size={16} /></a>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Services", href: "/services/" }, { label: "Unity development", href: "/services/unity-development/" }]} />
      </div>
      <div class="cluster sg-logos">
        <Logo size={56} />
        <Logo size={40} wordmark={false} />
      </div>
    </div>
  </Section>

  <Section id="icons" tone="raised" eyebrow="Foundations" title="Icons" lead="src/lib/icons.ts, rendered with <Icon name=… />. Brand marks are for profile links only.">
    <ul class="icons" role="list">
      {
        Object.keys(ICONS).map((name) => (
          <li>
            <Icon name={name} size={22} />
            <code>{name}</code>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="tones" tone="glow" align="center" eyebrow="Section tone: glow" title="The moon rises behind the heading" lead="Use tone='glow' once or twice per page, usually for the section that matters most.">
    <div class="sg-center cluster">
      <a class="btn btn--primary" href="/contact/">Contact us</a>
    </div>
  </Section>

  <Section id="services" tone="raised" eyebrow="ServiceCard" title="What we build" lead="Service cards link to their service page; the whole card is the target.">
    <Fragment slot="actions"><a class="link-arrow" href="/services/">All services <Icon name="arrowRight" size={16} /></a></Fragment>
    <div class="grid grid--3">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>
  </Section>

  <Section id="games" eyebrow="GameCard" title="Games" lead="Cover variant (2:3). Status and category come from the Game record.">
    <div class="grid grid--4">
      {games.map(({ game, img }) => <GameCard game={{ ...game, cover: img }} />)}
    </div>
    <h3 class="sg-sub">Wide variant and missing art</h3>
    <div class="grid grid--2">
      <GameCard game={{ ...games[1].game, wide: "styleguide/shots/hypno-halo-poster.jpg" }} variant="wide" />
      <GameCard game={noArtGame} variant="wide" />
    </div>
  </Section>

  <Section id="stores" tone="raised" eyebrow="StoreButton and AvailableOn" title="Store links" lead="Each store button carries its platform's mark. The full official logos sit beside them in an AvailableOn row.">
    <div class="stack" style="--stack-gap: 1.75rem">
      <div class="cluster">
        <StoreButton kind="steam" href={LINKS.sheepTag2Steam} verb="Wishlist on" variant="primary" placement="styleguide" />
        <StoreButton kind="switch" href={LINKS.hypnoHaloSwitch} placement="styleguide" />
        <StoreButton kind="unity" href={LINKS.scriptableSheets} placement="styleguide" />
        <StoreButton kind="web" href={LINKS.paralily} />
        <StoreButton kind="newgrounds" href={LINKS.newgrounds} size="sm" />
        <StoreButton kind="itch" href={LINKS.itch} />
      </div>
      <AvailableOn platforms={["steam", "switch"]} />

      {/* Prices come from src/data/store.json through src/lib/store.ts. Never type one. */}
      <h3 class="sg-sub">Price: live store data beside the button</h3>
      <div class="cluster" style="align-items: center">
        <StoreButton kind="unity" href={LINKS.scriptableSheets} variant="primary" placement="styleguide" />
        <Price slug="scriptable-sheets" store="unity" size="lg" />
      </div>
      <div class="cluster" style="align-items: center">
        <StoreButton kind="steam" href={LINKS.hypnoHaloSteam} verb="Buy on" placement="styleguide" />
        <Price slug="hypno-halo" store="steam" />
        <StoreButton kind="switch" href={LINKS.hypnoHaloSwitch} placement="styleguide" />
        <Price slug="hypno-halo" store="switch" />
      </div>
      <div class="cluster" style="align-items: center">
        <StoreButton kind="steam" href={LINKS.sheepTag2Steam} verb="Wishlist on" placement="styleguide" />
        <Price slug="sheep-tag-2" store="steam" unreleasedLabel="Early Access 2027" />
      </div>
      <p class="measure" style="color: var(--lw-ink-subtle); font-size: var(--lw-text-xs)">{PRICE_REGION_NOTE}</p>
    </div>
  </Section>

  <Section id="videos" eyebrow="VideoCard and Theater" title="Videos" lead="Posters are ours; YouTube loads only when someone presses play.">
    <div class="grid grid--3">
      <VideoCard id="GiCsebs_FK4" title="Hypno Halo trailer" poster={hypnoPoster} meta="Hypno Halo" />
      <VideoCard id="r_FJBZjHUpA" title="Scriptable Sheets overview" poster={shotMedium} meta="Unity Asset Store tool" />
      <VideoCard id="r_FJBZjHUpA" title="A card without a poster" />
    </div>
  </Section>

  <Section id="gallery" tone="raised" eyebrow="Gallery" title="Screenshots" lead="Click a shot: arrows, keyboard, swipe, Esc.">
    <Gallery images={shots} label="Hypno Halo screenshots" />
  </Section>

  <Section id="reviews" eyebrow="Reviews and ReviewCard" title="Our howling reviews" lead="Quotes are reproduced exactly, with their source.">
    <Reviews reviews={reviews} />
    <h3 class="sg-sub">Row layout (scroll-snap)</h3>
    <Reviews reviews={[...reviews, ...reviews]} layout="row" label="Reviews, scrolling row" />
  </Section>

  <Section id="partners" tone="raised" align="center" eyebrow="PartnerCloud" title="Our trusted pack" lead="Greyscale JPGs on white, knocked out per theme with CSS.">
    <PartnerCloud partners={partners} />
  </Section>

  <Section id="awards" tone="sky" align="center" eyebrow="AwardBadge and Stat" title="Recognition">
    <div class="awards">
      <AwardBadge label="East Coast Reboot game jam" title="1st place" year={2015} />
      <AwardBadge label="Boston Festival of Indie Games" title="Nominee, Haberdashery" year={2015} />
      <AwardBadge label="Delaware Innovation Awards" title="Indie Video Game of the Year nominee" year={2016} tone="accent" />
      <AwardBadge label="University of Delaware" title="Neurodiversity Employment Inclusion Excellence Award" year={2025} size="sm" />
    </div>
    <div class="stat-row sg-stats">
      <Stat value="300+" label="Handcrafted levels" note="Hypno Halo" />
      <Stat value="51" label="Bonus challenges" />
      <Stat value="50+" label="Achievements" tone="gold" />
      <Stat value="2015" label="Founded in Newark, Delaware" tone="ink" />
    </div>
  </Section>

  <Section id="founders" eyebrow="FounderCard" title="Our founders">
    <div class="grid grid--3">
      {founders.map((f) => <FounderCard founder={f} />)}
    </div>
    <h3 class="sg-sub">Row layout</h3>
    <FounderCard founder={founders[1]} layout="row" />
  </Section>

  <Section id="features" tone="raised" eyebrow="FeatureList" title="Features">
    <FeatureList items={features} columns={2} />
    <h3 class="sg-sub">Numbered (process steps)</h3>
    <FeatureList items={steps} numbered columns={3} />
  </Section>

  <Section id="faq" eyebrow="Faq" title="Publishing questions" width="narrow">
    <Faq items={faqs} open={0} />
  </Section>

  <Section id="forms" tone="raised" eyebrow="ContactForm and NewsletterForm" title="Forms">
    <div class="sg-forms">
      <div class="card card--pad">
        <ContactForm id="sg-contact" />
      </div>
      <div class="card card--pad stack">
        <h3>Newsletter (stacked)</h3>
        <NewsletterForm id="sg-newsletter" layout="stacked" label="Email address" />
      </div>
    </div>
  </Section>

  <Section id="prose" eyebrow="prose.css" title="Long-form text" width="narrow">
    <div class="prose sg-prose">
      <h2>Information we collect</h2>
      <p>
        Long-form pages such as the <a href="/privacy-policy/">privacy policy</a> use <code>.prose</code>. Lists, quotes and
        subheadings are styled without extra classes.
      </p>
      <ul>
        <li>Digits-in-noise (measures ability to understand speech in noisy environments)</li>
        <li>Pure tone (assesses hearing sensitivity)</li>
        <li>Sound localization (tests ability to determine the direction of a sound)</li>
      </ul>
      <blockquote>Our virtual reality hearing assessment gamifies traditional hearing tests.</blockquote>
    </div>
  </Section>

  <CtaBand secondary={{ label: "See our games", href: "/games/" }} />
</BaseLayout>

<style>
  .sg-hero-media {
    width: 100%;
