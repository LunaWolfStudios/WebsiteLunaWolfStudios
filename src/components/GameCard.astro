---
/**
 * A game or project card for grids: cover art, status and category badges, title, tagline,
 * role and platforms. The whole card is one link: the game's page on this site if it has
 * one, else its first store link.
 *
 *   {GAMES.filter((g) => g.featured).map((game) => <GameCard game={game} />)}
 *   <GameCard game={game} variant="wide" />       16:9 art, for rows of two
 *   <GameCard game={game} image={importedImage} /> override the art
 *
 * Art: `cover` (2:3 capsule, default variant) or `wide` (16:9) from the Game record, resolved
 * by src/lib/images.ts (tried inside src/assets/games/<slug>/ first). Missing art falls back
 * to a night-sky panel with the title, so a card never breaks the grid.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import type { Game } from "../data/types";
import { image as resolveImage } from "../lib/images";
import { withUtm, type LinkPlacement } from "../data/links";

interface Props {
  game: Game;
  variant?: "cover" | "wide";
  image?: ImageMetadata;
  /** UTM placement for outbound links (when the card leads to a store). */
  placement?: LinkPlacement;
  headingLevel?: 2 | 3 | 4;
  eager?: boolean;
  class?: string;
}

const { game, variant = "cover", placement = "games", headingLevel = 3, eager = false, class: cls } = Astro.props;
const ref = variant === "wide" ? (game.wide ?? game.cover) : (game.cover ?? game.wide);
const art = Astro.props.image ?? (ref ? resolveImage(ref, `games/${game.slug}`) : undefined);

const external = !game.page && game.links[0]?.url;
const href = game.page ?? (external ? withUtm(game.links[0].url, placement) : "#");
const H = `h${headingLevel}` as "h2" | "h3" | "h4";

const STATUS: Record<string, { label: string; cls: string }> = {
  released: { label: "Out now", cls: "" },
  upcoming: { label: "Coming soon", cls: "badge--gold" },
  "in-development": { label: "In development", cls: "badge--gold" },
  archived: { label: "Archived", cls: "badge--neutral" },
};
const CATEGORY: Record<Game["category"], string> = {
  studio: "Our game",
  published: "Published by us",
  client: "Client project",
  experience: "Experience",
  jam: "Game jam",
  internship: "Intern project",
};
// An upcoming game shows its own release note ("Early Access 2027"), never a vague "Coming soon".
const status = game.status
  ? game.status === "upcoming" && game.releaseNote
    ? { label: game.releaseNote, cls: "badge--gold" }
    : STATUS[game.status]
  : undefined;
const meta = [game.year, game.role].filter(Boolean).join(" · ");
const widths = variant === "wide" ? [480, 720, 960] : [300, 450, 600];
const sizes =
  variant === "wide"
    ? "(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 580px"
    : "(max-width: 640px) 50vw, (max-width: 1000px) 33vw, 280px";
---

<article class:list={["game-card", "card", "card--link", `game-card--${variant}`, cls]}>
  <div class="gc-art">
    {
      art ? (
        <Image
          src={art}
          alt=""
          widths={widths}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : undefined}
          decoding="async"
          class="gc-img"
        />
      ) : (
        <div class="gc-fallback sky" aria-hidden="true">
          <span>{game.title}</span>
        </div>
      )
    }
    {status && <span class:list={["badge", "gc-status", status.cls]}>{status.label}</span>}
  </div>
  <div class="gc-body">
    <p class="gc-kicker">{CATEGORY[game.category]}{game.owner && ` · ${game.owner}`}</p>
    <H class="gc-title">
      <a
        href={href}
        class="gc-link"
        target={external ? "_blank" : undefined}
        rel={external ? "noopener" : undefined}
      >
        {game.title}
      </a>
    </H>
    <p class="gc-tagline">{game.tagline}</p>
    {meta && <p class="gc-meta">{meta}</p>}
    {
      game.platforms?.length ? (
        <ul class="gc-platforms" role="list" aria-label="Platforms">
          {game.platforms.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      ) : null
    }
    <span class="gc-go" aria-hidden="true">
      {external ? <Icon name="external" size={16} /> : <Icon name="arrowRight" size={18} />}
    </span>
  </div>
</article>

<style>
  .game-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .gc-art {
    position: relative;
    aspect-ratio: 2 / 3;
    background: var(--lw-media-bg);
    overflow: hidden;
  }
  .game-card--wide .gc-art {
    aspect-ratio: 16 / 9;
  }
  .gc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--lw-ease);
  }
  .game-card:hover .gc-img {
    transform: scale(1.035);
  }
  .gc-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    background: radial-gradient(60% 50% at 50% 35%, var(--lw-glow-strong), transparent 70%), #070d12;
    color: #eef7f7;
    font-family: var(--lw-font-display);
    font-weight: 600;
    font-size: 1.25rem;
    text-align: center;
  }
  .gc-status {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  /* Badges sit on art, so they take the dark palette in both themes for contrast. */
  .gc-status:not(.badge--neutral) {
    background: rgba(4, 7, 10, 0.72);
    color: #81ebe1;
    border-color: rgba(129, 235, 225, 0.35);
  }
  .gc-status.badge--gold {
    color: #ffc96b;
    border-color: rgba(255, 201, 107, 0.4);
  }
  .gc-status.badge--neutral {
    background: rgba(4, 7, 10, 0.72);
    color: #c9d9dc;
    border-color: rgba(255, 255, 255, 0.18);
  }
  .gc-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    padding: 1rem 1.1rem 1.15rem;
  }
  .gc-kicker {
    font-size: var(--lw-text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lw-ink-subtle);
  }
  .gc-title {
    font-size: 1.2rem;
  }
  .gc-body > p:last-of-type,
  .gc-platforms {
    padding-right: 1.75rem;
  }
  .gc-link {
    color: var(--lw-ink);
    text-decoration: none;
  }
  /* The title link covers the whole card: one tab stop, one target. */
  .gc-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .game-card {
    isolation: isolate;
  }
  .gc-link:focus-visible {
    outline: none;
  }
  .game-card:has(.gc-link:focus-visible) {
    outline: 2px solid var(--lw-accent);
    outline-offset: 3px;
  }
  .game-card:hover .gc-link {
    color: var(--lw-accent);
  }
  .gc-tagline {
    color: var(--lw-ink-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .gc-meta {
    font-size: var(--lw-text-sm);
    color: var(--lw-ink-subtle);
  }
  .gc-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: auto 0 0;
    padding: 0.5rem 1.75rem 0 0;
  }
  .gc-platforms li {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2em 0.6em;
    border-radius: var(--lw-radius-pill);
    border: 1px solid var(--lw-border);
    color: var(--lw-ink-muted);
  }
  .gc-go {
    position: absolute;
    bottom: 1.05rem;
    right: 1rem;
    color: var(--lw-ink-subtle);
    transition: transform var(--lw-fast) ease, color var(--lw-fast) ease;
  }
  .game-card:hover .gc-go {
    color: var(--lw-accent);
    transform: translateX(3px);
  }
  /* Two-up on phones: tighter text so the card stays a card. */
  @media (max-width: 640px) {
    .game-card--cover .gc-body {
      padding: 0.75rem 0.8rem 0.9rem;
    }
    .game-card--cover .gc-title {
      font-size: 1.02rem;
    }
    .game-card--cover .gc-tagline {
      font-size: 0.85rem;
    }
    .game-card--cover .gc-kicker {
      font-size: 0.68rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .game-card:hover .gc-img {
      transform: none;
    }
  }
</style>
