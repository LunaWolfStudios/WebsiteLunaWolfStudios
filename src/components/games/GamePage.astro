---
/**
 * The game page template: /sheep-tag-2/, /hypno-halo/, /paralily/,
 * /the-brave-hearts-ii-false-skies/, /haberdashery/, /target-crack/.
 *
 *   <GamePage page={GAME_PAGES["hypno-halo"]} />
 *
 * Content comes from src/data/gamePages.ts (long-form copy) and src/data/games.ts (title,
 * platforms, links, credits). Section order: hero (store buttons with live prices, trailer)
 * → about → features → videos and screenshots → reviews and press → fact sheet with the
 * "Available on" logos and credits → related games → closing call to action. Extra blocks from
 * the data slot in after the about, media, or fact sheet sections. Section tones alternate
 * automatically, whichever sections a page has.
 */
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import GameHero from "./GameHero.astro";
import Section from "../Section.astro";
import VideoCard from "../VideoCard.astro";
import Gallery from "../Gallery.astro";
import Reviews from "../Reviews.astro";
import FeatureList from "../FeatureList.astro";
import GameCard from "../GameCard.astro";
import CtaBand from "../CtaBand.astro";
import AwardBadge from "../AwardBadge.astro";
import Price from "../Price.astro";
import Icon from "../Icon.astro";
import StorePair from "./StorePair.astro";
import StoreLogos from "./StoreLogos.astro";
import { game } from "../../data/games";
import { PRESS, REVIEWS, reviewsAbout } from "../../data/reviews";
import { ALL_VIDEOS } from "../../data/videos";
import { AWARDS } from "../../data/awards";
import { withUtm } from "../../data/links";
import type { Block, GamePageData } from "../../data/gamePages";
import type { Review } from "../../data/types";
import { image } from "../../lib/images";
import { getOffer, offerLd, PRICE_REGION_NOTE } from "../../lib/store";
import { videoGameLd, type JsonLd } from "../../lib/seo";

interface Props {
  page: GamePageData;
}

const { page } = Astro.props;
const g = game(page.slug);
const P = "game_page" as const;

// ─── Content lookups ──────────────────────────────────────────────────────────────────────
const reviews: Review[] = page.reviews
  ? page.reviews.ids
    ? page.reviews.ids.map((id) => {
        const r = REVIEWS.find((x) => x.id === id);
        if (!r) throw new Error(`[GamePage] Unknown review id "${id}".`);
        return r;
      })
    : reviewsAbout(page.slug)
  : [];
const press = page.press ? PRESS.filter((p) => page.press!.about.includes(p.about)) : [];
const videos = (page.videos?.ids ?? []).map((id) => {
  const v = ALL_VIDEOS.find((x) => x.id === id);
  if (!v) throw new Error(`[GamePage] Unknown video id "${id}".`);
  return v;
});
const awards = AWARDS.filter((a) => a.subjectSlug === page.slug);
const related = page.related.map((slug) => game(slug));
const credits = g.credits ?? [];
const hasPrice = page.stores.some((s) => s.price) || page.facts.some((f) => f.prices?.length);
// The fact sheet names the engine from games.ts when the page's own rows do not.
const facts =
  g.engine && !page.facts.some((f) => f.label === "Engine")
    ? (() => {
        const at = page.facts.findIndex((f) => f.label === "Genre");
        const rows = [...page.facts];
        rows.splice(at < 0 ? rows.length : at + 1, 0, { label: "Engine", value: g.engine });
        return rows;
      })()
    : page.facts;
const keyArt = page.keyArt;
// Screenshots large enough to read before they are opened; two across on tablets and phones.
// Phone-shaped shots run five across.
const shotCount = page.screenshots.items.length;
// Rows always fill: three across for six or nine shots, two across otherwise (eight shots
// make four rows of two, the largest thumbnails on the site).
const galleryColumns = page.screenshots.portrait ? 4 : (page.screenshots.columns ?? (shotCount > 4 && shotCount % 3 === 0 ? 3 : 2));
const gallerySizes = page.screenshots.portrait
  ? "(max-width: 640px) calc(50vw - 24px), (max-width: 1000px) 31vw, 230px"
  : galleryColumns === 2
    ? "(max-width: 640px) calc(50vw - 24px), (max-width: 1000px) 50vw, 590px"
    : "(max-width: 640px) calc(50vw - 24px), (max-width: 1000px) 50vw, 390px";
const blocksAt = (place: "afterAbout" | "afterMedia" | "afterFacts") => (page.blocks ?? []).filter((b) => b.place === place);

// ─── Section order and tones (alternate default and raised after the hero) ────────────────
type Key = string;
const order: Key[] = [
  "about",
  ...blocksAt("afterAbout").map((b) => b.id),
  ...(page.features ? ["features"] : []),
  "media",
  ...blocksAt("afterMedia").map((b) => b.id),
  ...(reviews.length || press.length ? ["reviews"] : []),
  "facts",
  ...blocksAt("afterFacts").map((b) => b.id),
  "related",
];
const tone = (key: Key) => (order.indexOf(key) % 2 === 0 ? "default" : "raised");

// ─── Formatting helpers ───────────────────────────────────────────────────────────────────
const fmtDate = (iso?: string) =>
  iso
    ? new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(iso))
    : undefined;
const PRESS_KIND: Record<string, string> = { article: "Article", review: "Review", video: "Video", podcast: "Podcast", list: "List" };
const creditHref = (c: { name: string; url?: string }) => (c.name === "Jeff" ? "/about-jeff/" : c.url);
// "Music by" over three "Music" roles says it once: drop a role every credit shares when the heading names it.
const sharedRole = credits.length > 1 && credits.every((c) => c.role === credits[0].role) ? credits[0].role : undefined;
const showRole = !(sharedRole && page.creditsTitle?.toLowerCase().includes(sharedRole.toLowerCase()));

// ─── Art and JSON-LD ──────────────────────────────────────────────────────────────────────
const wideArt = image(g.wide ?? g.cover!);
const og = await getImage({ src: wideArt, width: Math.min(1200, wideArt.width), format: "jpg", quality: 82 });
const trailer = page.hero.kind === "video" ? ALL_VIDEOS.find((v) => v.id === (page.hero as { videoId: string }).videoId) : undefined;
const heroPoster = image(page.hero.poster);
const posterLd = await getImage({ src: heroPoster, width: Math.min(1280, heroPoster.width), format: "jpg", quality: 80 });

const offers = page.stores.filter((s) => s.price).map((s) => offerLd(getOffer(s.price!.slug, s.price!.store)));
const studioMade = !g.developer || g.developer.startsWith("Luna Wolf Studios");
const ldUrl = page.ld.url ?? page.path;
let game_ld: JsonLd = videoGameLd({
  name: g.title,
  description: page.seo.description,
  url: ldUrl,
  image: og.src,
  genre: page.ld.genre,
  gamePlatform: g.platforms,
  playMode: page.ld.playMode,
  datePublished: page.ld.datePublished,
  developer: studioMade ? undefined : g.developer,
  sameAs: [...new Set(g.links.map((l) => l.url))].filter((u) => u !== page.ld.url),
  offers,
  award: awards.length ? awards.map((a) => (a.title.includes(a.body) ? a.title : `${a.title}, ${a.body}`)) : undefined,
  trailer:
    page.hero.kind === "video"
      ? {
          id: page.hero.videoId,
          name: trailer ? (trailer.title.toLowerCase().includes(g.title.toLowerCase()) ? trailer.title : `${g.title}: ${trailer.title}`) : page.hero.title,
          description: `${page.hero.title}. ${page.seo.description}`,
          uploadDate: trailer?.published,
          thumbnail: posterLd.src,
        }
      : undefined,
});
if (page.slug === "the-brave-hearts-ii-false-skies") game_ld = { ...game_ld, author: { "@type": "Person", name: "Connor Butler" } };
if (page.ld.maxPlayers) game_ld = { ...game_ld, numberOfPlayers: { "@type": "QuantitativeValue", minValue: 1, maxValue: page.ld.maxPlayers } };

const crumbs = [
  { label: "Games", href: "/games/" },
  { label: g.title, href: page.path },
];
const headingId = (b: Block) => `${b.id}`;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={wideArt}
  imageAlt={`${g.title} key art`}
  breadcrumbs={crumbs}
  hideBreadcrumbs={Boolean(keyArt)}
  headerOverlay={Boolean(keyArt)}
  jsonLd={game_ld}
>
  {
    keyArt ? (
      <GameHero
        art={image(keyArt.src)}
        layout={keyArt.layout}
        position={keyArt.position}
        backdrop={keyArt.backdrop ? image(keyArt.backdrop) : undefined}
        logo={keyArt.logo ? image(keyArt.logo) : undefined}
        name={g.title}
        eyebrow={page.eyebrow}
        title={page.h1}
        lead={page.lead}
        crumbs={crumbs}
      >
        {page.credit && <p class="gh-credit" set:html={page.credit} />}
        <ul class="gh-status" role="list" aria-label="Status and platforms">
          {page.status.map((s, i) => <li class:list={{ "is-key": i === 0 }}>{s}</li>)}
        </ul>
        <Fragment slot="actions">
          {page.stores.map((entry, i) => <StorePair entry={entry} primary={i === 0} />)}
          {page.hero.kind === "video" ? (
            <a
              class="btn btn--secondary gh-trailer"
              href={`https://www.youtube.com/watch?v=${page.hero.videoId}`}
              data-video-id={page.hero.videoId}
              data-video-next={page.hero.next}
              data-video-title={page.hero.title}
              target="_blank"
              rel="noopener"
            >
              <Icon name="play" size={18} /> Watch the trailer
            </a>
          ) : (
            <a class="btn btn--secondary gh-trailer" href={withUtm(page.hero.href, P)} target="_blank" rel="noopener">
              Watch the trailer on Steam <Icon name="arrowUpRight" size={18} />
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          )}
          {page.extraLinks?.length ? (
            <p class="gh-extra">
              {page.extraLinks.map((l) => (
                <a href={withUtm(l.href, P)} target="_blank" rel="noopener" class="link-arrow">
                  {l.label} <Icon name="arrowUpRight" size={16} />
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              ))}
            </p>
          ) : null}
        </Fragment>
      </GameHero>
    ) : (
      <PageHero eyebrow={page.eyebrow} title={page.h1} lead={page.lead} class="game-hero">
        {page.credit && <p class="gh-credit" set:html={page.credit} />}
        <ul class="gh-status" role="list" aria-label="Status and platforms">
          {page.status.map((s, i) => <li class:list={{ "is-key": i === 0 }}>{s}</li>)}
        </ul>
        <Fragment slot="actions">
          {page.stores.map((entry, i) => <StorePair entry={entry} primary={i === 0} />)}
          {page.extraLinks?.length ? (
            <p class="gh-extra">
              {page.extraLinks.map((l) => (
                <a href={withUtm(l.href, P)} target="_blank" rel="noopener" class="link-arrow">
                  {l.label} <Icon name="arrowUpRight" size={16} />
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              ))}
            </p>
          ) : null}
        </Fragment>
        <div slot="media" class="gh-media">
          {page.hero.kind === "video" ? (
            <VideoCard
              id={page.hero.videoId}
              title={page.hero.title}
              next={page.hero.next}
              poster={heroPoster}
              variant="feature"
              sizes="(max-width: 900px) calc(100vw - 32px), 600px"
              eager
            />
          ) : (
            <a class="gh-steam-trailer" href={withUtm(page.hero.href, P)} target="_blank" rel="noopener">
              <Image
                src={heroPoster}
                alt={page.hero.alt}
                widths={[640, 720, 960, 1232].filter((w) => w <= heroPoster.width)}
                sizes="(max-width: 900px) calc(100vw - 32px), 600px"
                loading="eager"
                fetchpriority="high"
                class="gh-steam-img"
              />
              <span class="gh-steam-play" aria-hidden="true">
                <Icon name="arrowUpRight" size={30} />
              </span>
              <span class="gh-steam-label">
                Watch the trailer on Steam <Icon name="arrowUpRight" size={18} />
                <span class="visually-hidden"> (opens in a new tab)</span>
              </span>
            </a>
          )}
        </div>
      </PageHero>
    )
  }

  {/* ─── About ─── */}
  <Section id="about" title={page.about.title} tone={tone("about")}>
    <div class:list={["about", `about--${page.about.art.shape ?? "portrait"}`]}>
      <div class="about-text" data-reveal>
        {page.about.paragraphs.map((p) => <p set:html={p} />)}
        {
          page.about.note && (
            <aside class="about-note" aria-label={page.about.note.title}>
              <Icon name="alert" size={22} />
              <p>
                <strong>{page.about.note.title}.</strong> {page.about.note.text}
              </p>
            </aside>
          )
        }
        {
          page.about.awards && awards.length > 0 && (
            <div class="about-awards">
              {awards.map((a) => (
                <AwardBadge award={a} />
              ))}
            </div>
          )
        }
      </div>
      <figure class="about-art" data-reveal>
        <Image
          src={image(page.about.art.src)}
          alt={page.about.art.alt}
          widths={[300, 450, 600]}
          sizes="(max-width: 760px) 60vw, 300px"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Section>

  {
    blocksAt("afterAbout").map((b) => (
      <Section id={headingId(b)} eyebrow={b.eyebrow} title={b.title} lead={"lead" in b ? b.lead : undefined} tone={tone(b.id)}>
        {b.kind === "prose" && (
          <div class="prose-block" data-reveal>
            {b.paragraphs.map((p) => (
              <p set:html={p} />
            ))}
            {b.listTitle && <p class="pb-list-title" set:html={b.listTitle} />}
            {b.list && (
              <ul class="checks checks--2" role="list">
                {b.list.map((item) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}
      </Section>
    ))
  }

  {/* ─── Features ─── */}
  {
    page.features && (
      <Section id="features" title={page.features.title} lead={page.features.lead} tone={tone("features")}>
        {page.features.style === "icons" ? (
          <FeatureList items={page.features.items} columns={2} />
        ) : (
          <ul class="checks checks--2 checks--lg" role="list">
            {page.features.items.map((f, i) => (
              <li data-reveal style={`--reveal-delay:${Math.min(i, 6) * 50}ms`}>
                <Icon name="checkCircle" size={22} />
                <span>
                  {f.url ? (
                    <a href={withUtm(f.url, P)} target="_blank" rel="noopener">
                      {f.title}
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  ) : (
                    f.title
                  )}
                </span>
              </li>
            ))}
          </ul>
        )}
      </Section>
    )
  }

  {/* ─── Videos and screenshots ─── */}
  <Section id="media" title={videos.length ? "Videos and screenshots" : page.screenshots.title} lead={page.screenshots.lead} tone={tone("media")}>
    {
      videos.length > 0 && (
        <>
          <h3 class="sub">{page.videos!.title}</h3>
          <div class:list={["grid", videos.length === 2 ? "grid--2" : "grid--3", "media-videos"]}>
            {videos.map((v, i) => (
              <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <VideoCard video={v} meta={v.length} />
              </div>
            ))}
          </div>
          <h3 class="sub">Screenshots</h3>
        </>
      )
    }
    <div class:list={["shots", { "shots--portrait": page.screenshots.portrait }]}>
      <Gallery
        images={page.screenshots.items}
        columns={galleryColumns}
        sizes={gallerySizes}
        aspect={page.screenshots.portrait ? "750 / 1334" : "16 / 9"}
        label={`${g.title} screenshots`}
        id={`${page.slug}-gallery`}
      />
    </div>
    {
      page.screenshots.more && (
        <>
          <h3 class="sub">{page.screenshots.more.title}</h3>
          <div class="shots shots--more">
            <Gallery
              images={page.screenshots.more.items}
              columns={page.screenshots.more.columns ?? 4}
              sizes="(max-width: 640px) calc(50vw - 24px), (max-width: 1000px) calc(50vw - 40px), 290px"
              label={`${g.title}: ${page.screenshots.more.title.toLowerCase()}`}
              id={`${page.slug}-gallery-more`}
            />
          </div>
        </>
      )
    }
  </Section>

  {
    blocksAt("afterMedia").map((b) => (
      <Section id={headingId(b)} eyebrow={b.eyebrow} title={b.title} lead={"lead" in b ? b.lead : undefined} tone={tone(b.id)}>
        {b.kind === "links" && (
          <ul class="link-cards" role="list">
            {b.items.map((item, i) => (
              <li class="card card--link link-card" data-reveal style={`--reveal-delay:${Math.min(i, 5) * 50}ms`}>
                <span class="lc-icon" aria-hidden="true">
                  <Icon name={item.icon} size={22} />
                </span>
                <h3 class="lc-title">
                  <a href={withUtm(item.href, P)} target="_blank" rel="noopener" class="lc-link">
                    {item.title}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </h3>
                <p class="lc-text">{item.text}</p>
                {item.price && <Price slug={item.price.slug} store={item.price.store} class="lc-price" />}
                <span class="lc-go" aria-hidden="true">
                  <Icon name="arrowUpRight" size={18} />
                </span>
              </li>
            ))}
          </ul>
        )}
        {b.kind === "history" && (
          <div class="history">
            <div class="history-main">
              {b.awardsFor && (
                <div class="history-awards" data-reveal>
                  {AWARDS.filter((a) => a.subjectSlug === b.awardsFor).map((a) => (
                    <AwardBadge award={a} />
                  ))}
                </div>
              )}
              <ol class="timeline" role="list">
                {b.items.map((item, i) => (
                  <li data-reveal style={`--reveal-delay:${Math.min(i, 6) * 40}ms`}>
                    <span class="tl-when">{item.when}</span>
                    <span class="tl-text" set:html={item.html} />
                  </li>
                ))}
              </ol>
            </div>
            {b.photos && (
              <div class="history-photos">
                {b.photos.map((ph) => (
                  <figure class="photo" data-reveal>
                    <Image src={image(ph.src)} alt={ph.alt} widths={[400, 640, 800]} sizes="(max-width: 900px) 100vw, 400px" loading="lazy" decoding="async" />
                    {ph.caption && <figcaption>{ph.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </div>
        )}
      </Section>
    ))
  }

  {/* ─── Reviews and press ─── */}
  {
    (reviews.length > 0 || press.length > 0) && (
      <Section
        id="reviews"
        title={reviews.length && press.length ? "Reviews and press" : (page.reviews?.title ?? page.press?.title)}
        lead={page.reviews?.lead}
        tone={tone("reviews")}
      >
        {reviews.length > 0 && (
          <>
            {press.length > 0 && <h3 class="sub sub--first">{page.reviews!.title}</h3>}
            <div class:list={["quotes", { "quotes--pairs": reviews.length === 2 || reviews.length === 4 }]}>
              <Reviews reviews={reviews} showAbout={false} label={`Quotes about ${g.title}`} />
            </div>
          </>
        )}
        {press.length > 0 && (
          <>
            {reviews.length > 0 && <h3 class="sub">{page.press!.title}</h3>}
            <ul class="press" role="list">
              {press.map((item, i) => (
                <li class="press-item" data-reveal style={`--reveal-delay:${Math.min(i, 5) * 50}ms`}>
                  <span class="pi-outlet">{item.outlet}</span>
                  <a class="pi-title" href={item.url} target="_blank" rel="noopener" lang={item.language === "Belarusian" ? "be" : undefined}>
                    {item.title}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                  <span class="pi-meta">
                    {[PRESS_KIND[item.kind], item.language ? `in ${item.language}` : undefined, fmtDate(item.date)].filter(Boolean).join(" · ")}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </Section>
    )
  }

  {/* ─── Fact sheet, where to get it, credits ─── */}
  <Section id="facts" title="Fact sheet" tone={tone("facts")}>
    <div class="facts">
      <dl class="factsheet" data-reveal>
        {
          facts.map((f) => (
            <div class="fs-row">
              <dt>{f.label}</dt>
              <dd>
                {f.prices ? (
                  <span class="fs-prices">
                    {f.prices.map((p) => (
                      <span class="fs-price">
                        {f.prices!.length > 1 && <span class="fs-price-name">{p.name}</span>}
                        <Price slug={p.slug} store={p.store} unreleasedLabel={p.unreleasedLabel} freeLabel={p.freeLabel} />
                      </span>
                    ))}
                  </span>
                ) : f.html ? (
                  <Fragment set:html={f.html} />
                ) : (
                  f.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="facts-side">
        <div class="card card--pad get-it" data-reveal>
          <h3 class="get-title">{page.getIt.title}</h3>
          <div class="get-stores">
            {page.stores.map((entry, i) => <StorePair entry={entry} primary={i === 0} size="sm" />)}
          </div>
          <StoreLogos game={g.title} items={page.getIt.logos} />
          {page.getIt.note && <p class="get-note">{page.getIt.note}</p>}
          {hasPrice && <p class="get-note get-note--fine">{PRICE_REGION_NOTE}</p>}
        </div>
        {
          credits.length > 0 && (
            <div class="card card--pad credits" data-reveal>
              <h3 class="get-title">{page.creditsTitle ?? "Credits"}</h3>
              <ul class="credit-list" role="list">
                {credits.map((c) => {
                  const href = creditHref(c);
                  return (
                    <li>
                      <span class="cr-name">
                        {href ? (
                          <a href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noopener" : undefined}>
                            {c.name}
                            {href.startsWith("http") && <span class="visually-hidden"> (opens in a new tab)</span>}
                          </a>
                        ) : (
                          c.name
                        )}
                      </span>
                      {showRole && <span class="cr-role">{c.role}</span>}
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </Section>

  {
    blocksAt("afterFacts").map((b) => (
      <Section id={headingId(b)} eyebrow={b.eyebrow} title={b.title} lead={"lead" in b ? b.lead : undefined} tone={tone(b.id)}>
        {b.kind === "assets" && (
          <div class="assets">
            {b.downloads.map((d) => (
              <figure class="card asset" data-reveal>
                <Image src={image(d.image)} alt={d.alt} widths={[320, 480, 640]} sizes="(max-width: 640px) 100vw, 320px" loading="lazy" decoding="async" class="asset-img" />
                <figcaption class="asset-body">
                  <a class="btn btn--secondary btn--sm" href={d.href} download>
                    <Icon name="download" size={16} /> {d.title}
                  </a>
                  <span class="asset-meta">{d.meta}</span>
                </figcaption>
              </figure>
            ))}
            <div class="card card--pad contact" data-reveal>
              <h3 class="get-title">Contact</h3>
              <dl class="contact-list">
                {b.contact.map((c) => (
                  <div>
                    <dt>{c.label}</dt>
                    <dd set:html={c.html} />
                  </div>
                ))}
              </dl>
            </div>
          </div>
        )}
      </Section>
    ))
  }

  {/* ─── Related ─── */}
  <Section id="related" title="More games" tone={tone("related")}>
    <a slot="actions" class="link-arrow" href="/games/">All games and projects <Icon name="arrowRight" size={16} /></a>
    <div class="grid grid--3">
      {
        related.map((r, i) => (
          <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <GameCard game={r.category === "jam" && r.page ? { ...r, category: "studio" } : r} variant="wide" placement={P} image={r.wide ? undefined : r.videoId ? image(`videos/${r.videoId}.jpg`) : undefined} />
          </div>
        ))
      }
    </div>
  </Section>

  <CtaBand title={page.cta.title} lead={page.cta.lead} primary={page.cta.primary} secondary={page.cta.secondary} />
</BaseLayout>

