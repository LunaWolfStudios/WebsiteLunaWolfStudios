---
/**
 * What a service covers: a grid of capabilities, each a noun-phrase title (h3) and one line of
 * plain explanation. Editorial rather than boxed, so it reads differently from the project
 * cards further down the page.
 *
 *   <CapabilityGrid items={[{ title: "Online multiplayer", text: "..." }]} />
 */
import type { Capability } from "../../data/servicePages";

interface Props {
  items: Capability[];
  class?: string;
}

const { items, class: cls } = Astro.props;
---

<ul class:list={["cap-grid", cls]} role="list">
  {
    items.map((item, i) => (
      <li class="cap" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
        <h3 class="cap-title">{item.title}</h3>
        <p class="cap-text">{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.2vw, 2.5rem) clamp(1.5rem, 3.5vw, 3rem);
    margin: 0;
    padding: 0;
  }
  .cap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--lw-border);
  }
  /* A short moonlit stroke on the rule marks the start of each item. */
  .cap::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--lw-accent);
  }
  .cap-title {
    font-size: 1.12rem;
    line-height: 1.3;
  }
  .cap-text {
    color: var(--lw-ink-muted);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .cap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .cap-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
